Header
  + name := Yaif_model
  // Context mixing (paq style) for Yaif_codec: 5 context models give a probability for each
  // binary decision, a logistic mixer combines them, a 12-bit range coder codes the bit.
  // Integer arithmetic only: the encoder and the decoder stay identical bit for bit.

Public

  - decoding:Boolean

  //
  // Range coder (LZMA carry scheme), 12-bit probability of a 1 bit.
  //

  - low:Int

  - range:Int

  - cache:Int

  - cache_size:Int

  - code:Int

  - inp:C_array Uint8

  - in_pos:Int

  - in_end:Int

  // Set when the decoder reads past the end of its block (corrupt data).
  - overrun:Boolean

  // The first byte of an LZMA-style stream is always 0: it is not written, the decoder assumes it.
  - first_byte:Boolean

  - shift_low <-
  ( + carry:Int
    ((low < 0FF000000h) || {low > 0FFFFFFFFh}).if {
      carry := low >> 32
      (first_byte).if { first_byte := False } else { Yaif_codec.put_byte (cache + carry) }
      {cache_size > 1}.while_do {
        Yaif_codec.put_byte (0FFh + carry)
        cache_size := cache_size - 1
      }
      cache_size := 0
      cache := (low >> 24) & 0FFh
    }
    cache_size := cache_size + 1
    low := (low & 00FFFFFFh) << 8
  )

  - next_byte:Int <-
  // Past the end the stream reads as zeros (the flush omits them); far past it is corrupt.
  ( + result:Int
    (in_pos < in_end).if {
      result := (inp.at in_pos).to_int
    }.elseif {in_pos >= in_end + 4} then {
      overrun := True
    }
    in_pos := in_pos + 1
    result
  )

  - code_bit y:Int prob p:Int :Int <-
  // p = P(1) in [1,4095]. Encoder: codes y. Decoder: returns the decoded bit.
  ( + bound,result:Int
    bound := (range >> 12) * (4096 - p)
    (decoding).if {
      (code < bound).if {
        range := bound
      } else {
        code := code - bound
        range := range - bound
        result := 1
      }
      {range < 01000000h}.while_do {
        range := range << 8
        code := ((code << 8) | next_byte) & 0FFFFFFFFh
      }
    } else {
      result := y
      (y = 0).if {
        range := bound
      } else {
        low := low + bound
        range := range - bound
      }
      {range < 01000000h}.while_do {
        range := range << 8
        shift_low
      }
    }
    result
  )

  // Level 1: only the 2 direct models and mixer 1 (no hash tables, no mixer 2, no APM).
  - lite:Boolean

  - nact:Int

  // Level 4: a 3rd mixer (selected by the plane-0 error) averaged with the 2 others.
  - ultra:Boolean

  - start_encoder n:Int level lv:Int <-
  (
    lite := lv < 2
    ultra := lv >= 4
    decoding := False
    low := 0
    range := 0FFFFFFFFh
    cache := 0
    cache_size := 1
    first_byte := True
    reset_models n
  )

  - flush_encoder <-
  // Any value in [low, low + range) decodes right; range >= 2^24, so round low up to a multiple
  // of 2^24: its 3 low bytes are zeros, which the decoder supplies itself.
  (
    low := (low + 0FFFFFFh) & 1FF000000h
    shift_low
    shift_low
  )

  - start_decoder data:C_array Uint8 from pos:Int size len:Int samples n:Int level lv:Int <-
  (
    lite := lv < 2
    ultra := lv >= 4
    decoding := True
    inp := data
    in_pos := pos
    in_end := pos + len
    overrun := False
    range := 0FFFFFFFFh
    code := 0
    1.to 4 do { i:Int
      code := (code << 8) | next_byte
    }
    reset_models n
  )

  //
  // Logistic domain: squash(d) = 4096 / (1 + e^(-d/256)), stretch = its inverse (paq7 tables).
  //

  - squash_t:C_array Int := C_array Int.create 33

  // squash of every d in -2048..2047, at d + 2048 (the mixer's hot path).
  - sq_t:C_array Int := C_array Int.create 4096

  - sqt d:Int :Int <- sq_t.at (d + 2048)

  - stretch_t:C_array Int := C_array Int.create 4096

  // rate_t n = 65536 / (n + 1.5): adaptation rate of a counter seen n times.
  - rate_t:C_array Int := C_array Int.create 1024

  - tables_ready:Boolean

  - squash d:Int :Int <-
  ( + w,i,result:Int
    (d > 2047).if {
      result := 4095
    }.elseif {d < -2047} then {
      result := 0
    } else {
      w := d & 127
      i := (d >> 7) + 16
      result := ((squash_t.at i) * (128 - w) + (squash_t.at (i + 1)) * w + 64) >> 7
    }
    result
  )

  - make_tables <-
  ( + i,x,v,pi:Int
    + s:String
    s := "1 2 3 6 10 16 27 45 73 120 194 310 488 747 1101 1546 2047 2549 2994 3348 3607 3785 3901 3975 4024 4050 4068 4079 4085 4089 4092 4093 4094 "
    i := 0
    v := 0
    s.lower.to (s.upper) do { j:Int
      ((s.at j) = ' ').if {
        squash_t.at i put v
        i := i + 1
        v := 0
      } else {
        v := v * 10 + ((s.at j).to_int - '0'.to_int)
      }
    }
    0.to 4095 do { j:Int
      sq_t.at j put (squash (j - 2048))
    }
    pi := 0
    x := -2047
    {x <= 2047}.while_do {
      v := squash x
      pi.to v do { j:Int
        stretch_t.at j put x
      }
      (v + 1 > pi).if { pi := v + 1 }
      x := x + 1
    }
    pi.to 4095 do { j:Int
      stretch_t.at j put 2047
    }
    0.to 1023 do { n:Int
      rate_t.at n put (131072 / (2 * n + 3))
    }
    tables_ready := True
  )

  //
  // Counters (32 bits): slot = p16 << 10 | n, p16 = P(1) on 16 bits, n = times seen (capped).
  //

  // Models 0..1 are direct tables, 2..nm-1 hashed tables of 2^hbits slots, no collision check.
  // ponytail: 2^22 slots max per hashed model; collisions grow on > 12 Mpx images, add checksums if it shows.
  - nm:Int := 7

  // Yaif_lossy uses 92160 direct slots (twice the lossless layout).
  - nd_direct:Int := 92160

  // m0 (plane, activity): 4 * 16 * 80 slots, then m1 (plane, error energy, plane-0 error): 4 * 128 * 80.
  // Grown on demand to what the region needs (a small image never allocates the 168 MB maximum).
  - t:C_array Uint32 := C_array Uint32.create 92160

  - tcap:Int := 92160

  - hbits:Int

  // Contexts of the current sample, set by Yaif_codec: base index (direct) or hash (hashed).
  - ctx:C_array Int := C_array Int.create 8

  - wbase:Int

  - abase:Int

  // ws: mixer weight set of the sample (plane, activity); as: its APM context.
  - wbase2:Int

  - wbase3:Int

  // Mixer weight sets are indexes (set * 10 + node class); each set has nm + 2 weights:
  // the models, the match model (index nm), the bias (index nm + 1).
  - set_weights ws:Int and ws2:Int and ws3:Int apm as:Int <-
  (
    wbase := ws
    wbase2 := ws2
    wbase3 := ws3
    abase := as
  )

  // Per decision: slot index and stretched probability of each model; mixer input nm = bias.
  - idx:C_array Int := C_array Int.create 8

  - st:C_array Int := C_array Int.create 10

  // Mixer: 16 sets (plane * activity/4) * 10 node classes, of nm + 2 weights, 1.0 = 65536.
  - weights:C_array Int := C_array Int.create 1440

  // Second mixer: 320 weight sets (plane * error energy q1 * 10 node classes); outputs are averaged.
  - weights2:C_array Int := C_array Int.create 2880

  // Third mixer (level 4): plane * plane-0 error q2 * 10 node classes.
  - weights3:C_array Int := C_array Int.create 2880

  // APM (secondary estimation): per (plane, activity, node class), 33 buckets over stretch(p), 16 bits.
  - apm:C_array Int := C_array Int.create (640 * 33)

  - reset_models n:Int <-
  // n = number of samples of the region: sizes the hash tables (small deltas reset fast).
  (
    (tables_ready).if { } else { make_tables }
    nact := nm
    (lite).if { nact := 2 }
    hbits := 12
    {(hbits < 22) && {(1 << hbits) < n * 2}}.while_do { hbits := hbits + 1 }
    (lite).if { hbits := 0 }
    // Level 1 has no hashed model: only the direct tables are allocated and cleared.
    ((nd_direct + ((nact - 2) << hbits)) > tcap).if {
      tcap := nd_direct + ((nact - 2) << hbits)
      t := C_array Uint32.create tcap
    }
    0.to (nd_direct + ((nact - 2) << hbits) - 1) do { i:Int
      t.at i put ((32768 << 10).to_uint32)
    }
    0.to 1439 do { i:Int
      weights.at i put (65536 * 3 / 10)
    }
    0.to 159 do { i:Int
      mt.at i put (32768 << 10)
    }
    0.to 2879 do { i:Int
      weights2.at i put (65536 * 3 / 10)
      weights3.at i put (65536 * 3 / 10)
    }
    0.to (640 * 33 - 1) do { i:Int
      apm.at i put ((squash (((i % 33) - 16) * 128)) * 16)
    }
  )

  - update i:Int bit y:Int limit lim:Int <-
  ( + v,p,n:Int
    v := (t.at i).to_int
    p := v >> 10
    n := v & 1023
    (y = 1).if {
      p := p + (((65535 - p) * (rate_t.at n)) >> 16)
    } else {
      p := p - ((p * (rate_t.at n)) >> 16)
    }
    (n < lim).if { n := n + 1 }
    t.at i put (((p << 10) | n).to_uint32)
  )

  - hash h:Int with v:Int :Int <- (((h * 16777619) & 0FFFFFFFFh) ^ (v & 0FFFFFFFFh))

  // Current 16-slot bucket of each hashed model: all decisions of a group share a cache line pair.
  - gb:C_array Int := C_array Int.create 8

  - group g:Int <-
  // Selects, in each hashed model, the bucket of (sample context, decision group g),
  // and prefetches it: the bucket is read by the next bit(), usually a cache miss.
  ( + x,b:Int
    + tb:C_array Uint32
    tb := t
    2.to (nact - 1) do { k:Int
      x := ((ctx.at k) + g * 40503) & 0FFFFFFFFh
      x := (x * 2146121005) & 0FFFFFFFFh
      b := nd_direct + ((k - 2) << hbits) + ((x >> (36 - hbits)) << 4)
      gb.at k put b
      `__builtin_prefetch(&(@tb)[@b])`;
    }
  )

  - lr:Int := 6

  //
  // Match model input: the codec finds an earlier pixel whose neighbourhood matches and passes,
  // for each decision, the bit that pixel predicts (hint 0/1, -1 none). A counter per
  // (match length bucket, node class) learns how often the hint is right.
  //

  - mt:C_array Int := C_array Int.create 160

  - mlb:Int

  - set_match len_bucket:Int <- ( mlb := len_bucket; )

  - mt_update i:Int ok y:Int <-
  ( + v,p,n:Int
    v := mt.at i
    p := v >> 10
    n := v & 1023
    (y = 1).if {
      p := p + (((65535 - p) * (rate_t.at n)) >> 16)
    } else {
      p := p - ((p * (rate_t.at n)) >> 16)
    }
    (n < 255).if { n := n + 1 }
    mt.at i put ((p << 10) | n)
  )


  - clamp d:Int :Int <-
  ( + result:Int
    result := d
    (result < -2047).if { result := -2047 }
    (result > 2047).if { result := 2047 }
    result
  )

  - bit y:Int node nd:Int slot off:Int hint hv:Int :Int <-
  // Codes (or decodes) one binary decision. nd: small node id (0..79) for the direct models,
  // off: slot 0..15 in the current bucket (see group) for the hashed ones.
  // Mixer inputs: the nact active models, then the bias (weight index nm).
  ( + ws,ws2,ws3,cls,dot,dot2,dot3,p,p1,p2,p3,pm,err,a,j,wt,mi,sm,result:Int
    idx.at 0 put ((ctx.at 0) + nd)
    idx.at 1 put ((ctx.at 1) + nd)
    2.to (nact - 1) do { k:Int
      idx.at k put ((gb.at k) + off)
    }
    cls := 9
    (nd < 16).if { cls := nd }
    ws := (wbase * 10 + cls) * (nm + 2)
    ws2 := (wbase2 * 10 + cls) * (nm + 2)
    ws3 := (wbase3 * 10 + cls) * (nm + 2)
    0.to (nact - 1) do { k:Int
      st.at k put (stretch_t.at (((t.at (idx.at k)).to_int) >> 14))
      dot := dot + (weights.at (ws + k)) * (st.at k)
      dot2 := dot2 + (weights2.at (ws2 + k)) * (st.at k)
    }
    // Match input: +stretch(P(hint right)) towards the hinted bit.
    mi := mlb * 10 + cls
    sm := 0
    (hv >= 0).if {
      sm := stretch_t.at ((mt.at mi) >> 14)
      (hv = 0).if { sm := - sm }
    }
    st.at nm put sm
    dot := dot + (weights.at (ws + nm)) * sm
    dot2 := dot2 + (weights2.at (ws2 + nm)) * sm
    (ultra).if {
      0.to (nact - 1) do { k:Int
        dot3 := dot3 + (weights3.at (ws3 + k)) * (st.at k)
      }
      dot3 := dot3 + (weights3.at (ws3 + nm)) * sm
      dot3 := clamp ((dot3 + (weights3.at (ws3 + nm + 1)) * 256) >> 16)
      p3 := sqt dot3
    }
    dot := clamp ((dot + (weights.at (ws + nm + 1)) * 256) >> 16)
    dot2 := clamp ((dot2 + (weights2.at (ws2 + nm + 1)) * 256) >> 16)
    p1 := sqt dot
    p2 := sqt dot2
    (lite).if {
      p := p1
      a := -1
    } else {
      (ultra).if { pm := sqt ((dot + dot2 + dot3) / 3) } else { pm := sqt ((dot + dot2) >> 1) }
      // APM: interpolate between the 2 buckets around stretch(pm), average with pm.
      wt := (stretch_t.at pm) + 2048
      a := (abase + cls) * 33 + (wt >> 7)
      wt := wt & 127
      p := (pm + 3 * ((((apm.at a) * (128 - wt) + (apm.at (a + 1)) * wt) >> 7) >> 4)) >> 2
    }
    (p < 1).if { p := 1 }
    (p > 4095).if { p := 4095 }
    result := code_bit y prob p
    (a >= 0).if {
      j := a + (wt >> 6)
      apm.at j put ((apm.at j) + (((result << 16) - (result) - (apm.at j)) >> 7))
    }
    (hv >= 0).if { mt_update mi ok ((result = hv).to_int) }
    update (idx.at 0) bit result limit 1000
    update (idx.at 1) bit result limit 1000
    2.to (nact - 1) do { k:Int
      update (idx.at k) bit result limit 60
    }
    err := ((result << 12) - p1) * lr
    0.to (nact - 1) do { k:Int
      weights.at (ws + k) put ((weights.at (ws + k)) + (((st.at k) * err) >> 14))
    }
    weights.at (ws + nm) put ((weights.at (ws + nm)) + ((sm * err) >> 14))
    weights.at (ws + nm + 1) put ((weights.at (ws + nm + 1)) + ((256 * err) >> 14))
    (lite).if { } else {
      err := ((result << 12) - p2) * lr
      0.to (nact - 1) do { k:Int
        weights2.at (ws2 + k) put ((weights2.at (ws2 + k)) + (((st.at k) * err) >> 14))
      }
      weights2.at (ws2 + nm) put ((weights2.at (ws2 + nm)) + ((sm * err) >> 14))
      weights2.at (ws2 + nm + 1) put ((weights2.at (ws2 + nm + 1)) + ((256 * err) >> 14))
    }
    (ultra).if {
      err := ((result << 12) - p3) * lr
      0.to (nact - 1) do { k:Int
        weights3.at (ws3 + k) put ((weights3.at (ws3 + k)) + (((st.at k) * err) >> 14))
      }
      weights3.at (ws3 + nm) put ((weights3.at (ws3 + nm)) + ((sm * err) >> 14))
      weights3.at (ws3 + nm + 1) put ((weights3.at (ws3 + nm + 1)) + ((256 * err) >> 14))
    }
    result
  )
