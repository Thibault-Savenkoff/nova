Header
  + name := Nova_wavelet
  // CDF 9/7 wavelet (JPEG 2000 lifting constants, in 1/4096), in place on one plane of Int32.
  // Mallat levels stay interleaved: level k works on the samples at multiples of 2^k, so after
  // level k the low-low band is at multiples of 2^(k+1). Mirror extension at the borders.
  // No final scaling: integer lifting is exactly invertible, band gains go into the quantizer steps.

Public

  - c:C_array Int32

  - w:Int

  - h:Int

  - levels:Int

  - get i:Int :Int <- (c.at i).to_int

  - lift (base,step,n:Int) coef k:Int parity par:Int sign sg:Int <-
  // x[j] += sg * round(k * (x[j-1] + x[j+1]) / 4096) for j = par, par + 2, ... (n >= 2)
  ( + j,l,r:Int
    j := par
    {j < n}.while_do {
      l := j - 1
      (l < 0).if { l := 1 }
      r := j + 1
      (r >= n).if { r := n - 2 }
      c.at (base + j * step) put (((get (base + j * step)) + sg * ((k * ((get (base + l * step)) + (get (base + r * step))) + 2048) >> 12)).to_raw_int32)
      j := j + 2
    }
  )

  - lift_cols (nw,st,n:Int) coef k:Int parity par:Int sign sg:Int <-
  // Same as lift on every column i * st (0 <= i < nw) at once, row by row: memory is walked
  // in order instead of with a stride of st * w.
  ( + j,l,r,rs,a,b,d:Int
    rs := st * w
    j := par
    {j < n}.while_do {
      l := j - 1
      (l < 0).if { l := 1 }
      r := j + 1
      (r >= n).if { r := n - 2 }
      a := l * rs
      b := r * rs
      d := j * rs
      0.to (nw - 1) do { i:Int
        c.at (d + i * st) put (((get (d + i * st)) + sg * ((k * ((get (a + i * st)) + (get (b + i * st))) + 2048) >> 12)).to_raw_int32)
      }
      j := j + 2
    }
  )

  - cols (nw,st,n:Int) inverse inv:Boolean <-
  (
    (n >= 2).if {
      (inv).if {
        lift_cols (nw, st, n) coef 1817 parity 0 sign (-1)
        lift_cols (nw, st, n) coef 3616 parity 1 sign (-1)
        lift_cols (nw, st, n) coef (-217) parity 0 sign (-1)
        lift_cols (nw, st, n) coef (-6497) parity 1 sign (-1)
      } else {
        lift_cols (nw, st, n) coef (-6497) parity 1 sign 1
        lift_cols (nw, st, n) coef (-217) parity 0 sign 1
        lift_cols (nw, st, n) coef 3616 parity 1 sign 1
        lift_cols (nw, st, n) coef 1817 parity 0 sign 1
      }
    }
  )

  - line (base,step,n:Int) inverse inv:Boolean <-
  (
    (n >= 2).if {
      (inv).if {
        lift (base, step, n) coef 1817 parity 0 sign (-1)
        lift (base, step, n) coef 3616 parity 1 sign (-1)
        lift (base, step, n) coef (-217) parity 0 sign (-1)
        lift (base, step, n) coef (-6497) parity 1 sign (-1)
      } else {
        lift (base, step, n) coef (-6497) parity 1 sign 1
        lift (base, step, n) coef (-217) parity 0 sign 1
        lift (base, step, n) coef 3616 parity 1 sign 1
        lift (base, step, n) coef 1817 parity 0 sign 1
      }
    }
  )

  - setup plane:C_array Int32 size (pw,ph:Int) <-
  // Levels: halve while both sides keep >= 8 samples, 6 at most.
  (
    c := plane
    w := pw
    h := ph
    levels := 0
    {(levels < 6) && {((w + (1 << levels) - 1) >> levels) >= 16} && {((h + (1 << levels) - 1) >> levels) >= 16}}.while_do {
      levels := levels + 1
    }
  )

  - level k:Int inverse inv:Boolean <-
  ( + st,nw,nh:Int
    st := 1 << k
    nw := (w + st - 1) >> k
    nh := (h + st - 1) >> k
    (inv).if {
      cols (nw, st, nh) inverse True
      0.to (nh - 1) do { i:Int
        line (i * st * w, st, nw) inverse True
      }
    } else {
      0.to (nh - 1) do { i:Int
        line (i * st * w, st, nw) inverse False
      }
      cols (nw, st, nh) inverse False
    }
  )

  - forward <-
  (
    0.to (levels - 1) do { k:Int
      level k inverse False
    }
  )

  - inverse <-
  (
    (levels - 1).downto 0 do { k:Int
      level k inverse True
    }
  )
