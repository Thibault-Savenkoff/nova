Header
  + name := Nova_hdr
  // HDR from a gain map (ISO 21496-1 metadata, as in a HEIC `tmap` item):
  // - Ultra HDR JPEG: SDR JPEG + gain map JPEG, hdrgm XMP (Adobe/Google) and an MPF index;
  // - linear HDR (the full alternate rendition) coded PQ, 16 bits, for PNG (cICP) and 10-bit HEIF,
  //   or as half floats (linear, BT.709) for TIFF.
  // HDR = (SDR + offset_sdr) * 2^(min + (max - min) * g^(1/gamma)) - offset_hdr, SDR white = 203 nits.
  // ponytail: first channel's metadata only (iPhone gain maps have one); gain map upsampled bilinearly.
  - include := `
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
`;
  - external := `
static double nx_min, nx_max, nx_gamma, nx_osdr, nx_ohdr, nx_hbase, nx_halt;
static unsigned char *nx_out;
static long nx_n, nx_cap;

static void nx_put(const void *p, long n) {
  if (nx_n + n > nx_cap) {
    nx_cap = (nx_n + n) * 2 + 4096;
    nx_out = realloc(nx_out, nx_cap);
  }
  memcpy(nx_out + nx_n, p, n);
  nx_n += n;
}
static void nx_str(const char *s) { nx_put(s, strlen(s)); }

static long nx_u32(const unsigned char *p) { return (long)((unsigned long)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]); }
static double nx_frac(const unsigned char *p, int sgn) {
  long n = nx_u32(p), d = nx_u32(p + 4);
  if (sgn && n > 0x7FFFFFFFL) n -= 0x100000000L;
  return d ? (double)n / d : 0;
}

/* ISO 21496-1 metadata (version 0): 1 on success. */
static int nx_parse(const unsigned char *m, int n) {
  /* flags other than multichannel and base colour space change the layout: unsupported */
  if (n < 62 || m[0] != 0 || (m[5] & 0x3F)) return 0;
  nx_hbase = nx_frac(m + 6, 0);
  nx_halt = nx_frac(m + 14, 0);
  nx_min = nx_frac(m + 22, 1);
  nx_max = nx_frac(m + 30, 1);
  nx_gamma = nx_frac(m + 38, 0);
  nx_osdr = nx_frac(m + 46, 1);
  nx_ohdr = nx_frac(m + 54, 1);
  if (nx_gamma <= 0) nx_gamma = 1;
  return 1;
}

/* XMP of the gain map JPEG (nx_out). */
static void nx_xmp_gm(void) {
  char b[1024];
  nx_n = 0;
  snprintf(b, sizeof b,
    "<x:xmpmeta xmlns:x=\"adobe:ns:meta/\"><rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">"
    "<rdf:Description xmlns:hdrgm=\"http://ns.adobe.com/hdr-gain-map/1.0/\" hdrgm:Version=\"1.0\""
    " hdrgm:GainMapMin=\"%.6f\" hdrgm:GainMapMax=\"%.6f\" hdrgm:Gamma=\"%.6f\" hdrgm:OffsetSDR=\"%.6f\""
    " hdrgm:OffsetHDR=\"%.6f\" hdrgm:HDRCapacityMin=\"%.6f\" hdrgm:HDRCapacityMax=\"%.6f\""
    " hdrgm:BaseRenditionIsHDR=\"False\"/></rdf:RDF></x:xmpmeta>",
    nx_min, nx_max, nx_gamma, nx_osdr, nx_ohdr, nx_hbase, nx_halt);
  nx_str(b);
}

/* XMP of the primary JPEG (nx_out): the container directory, gain map of gn bytes. With the
   source's XMP packet src[0, sn), inserted into it as one more rdf:Description. */
static void nx_xmp_primary(long gn, const unsigned char *src, long sn) {
  char b[1024];
  long i, at = -1;
  for (i = sn - 10; i >= 0 && at < 0; i--) if (!memcmp(src + i, "</rdf:RDF>", 10)) at = i;
  nx_n = 0;
  if (at >= 0) nx_put(src, at);
  else nx_str("<x:xmpmeta xmlns:x=\"adobe:ns:meta/\"><rdf:RDF xmlns:rdf=\"http://www.w3.org/1999/02/22-rdf-syntax-ns#\">");
  snprintf(b, sizeof b,
    "<rdf:Description xmlns:Container=\"http://ns.google.com/photos/1.0/container/\""
    " xmlns:Item=\"http://ns.google.com/photos/1.0/container/item/\""
    " xmlns:hdrgm=\"http://ns.adobe.com/hdr-gain-map/1.0/\" hdrgm:Version=\"1.0\">"
    "<Container:Directory><rdf:Seq>"
    "<rdf:li rdf:parseType=\"Resource\"><Container:Item Item:Semantic=\"Primary\" Item:Mime=\"image/jpeg\"/></rdf:li>"
    "<rdf:li rdf:parseType=\"Resource\"><Container:Item Item:Semantic=\"GainMap\" Item:Mime=\"image/jpeg\" Item:Length=\"%ld\"/></rdf:li>"
    "</rdf:Seq></Container:Directory></rdf:Description>", gn);
  nx_str(b);
  if (at >= 0) nx_put(src + at, sn - at);
  else nx_str("</rdf:RDF></x:xmpmeta>");
}

static void nx_be32(unsigned char *p, unsigned long v) { p[0] = v >> 24; p[1] = v >> 16; p[2] = v >> 8; p[3] = v; }

/* Primary JPEG + gain map JPEG -> Ultra HDR file in nx_out: an MPF segment (APP2) after the
   JFIF APP0, then the gain map after the primary's EOI. */
static void nx_ultrahdr(const unsigned char *pri, long pn, const unsigned char *gm, long gn) {
  static const unsigned char head[] = {
    0xFF, 0xE2, 0, 88, 'M', 'P', 'F', 0,
    'M', 'M', 0, 42, 0, 0, 0, 8,                     /* TIFF header, big-endian, IFD at 8 */
    0, 3,                                            /* 3 entries */
    0xB0, 0x00, 0, 7, 0, 0, 0, 4, '0', '1', '0', '0',  /* MPFVersion */
    0xB0, 0x01, 0, 4, 0, 0, 0, 1, 0, 0, 0, 2,          /* NumberOfImages */
    0xB0, 0x02, 0, 7, 0, 0, 0, 32, 0, 0, 0, 50,        /* MPEntry: 2 x 16 bytes at 50 */
    0, 0, 0, 0 };                                    /* no next IFD */
  unsigned char mpf[90], *e;
  long a0 = 2, tiff, total;
  /* After SOI and the JFIF APP0 when there is one. */
  if (pn > 6 && pri[2] == 0xFF && pri[3] == 0xE0) a0 = 4 + (pri[4] << 8 | pri[5]);
  memset(mpf, 0, sizeof mpf);
  memcpy(mpf, head, sizeof head);
  total = pn + sizeof mpf;
  tiff = a0 + 8;
  e = mpf + 8 + 50;
  nx_be32(e, 0x030000);                              /* primary image, baseline JPEG */
  nx_be32(e + 4, total);
  nx_be32(e + 16 + 4, gn);
  nx_be32(e + 16 + 8, total - tiff);                 /* offset from the TIFF header */
  nx_n = 0;
  nx_put(pri, a0);
  nx_put(mpf, sizeof mpf);
  nx_put(pri + a0, pn - a0);
  nx_put(gm, gn);
}

static double nx_srgb(double v) { return v <= 0.04045 ? v / 12.92 : pow((v + 0.055) / 1.055, 2.4); }
static double nx_pq(double nits) {
  double y = pow(nits / 10000, 0.1593017578125);
  return pow((0.8359375 + 18.8515625 * y) / (1 + 18.6875 * y), 78.84375);
}

/* IEEE half of v (round to nearest; no NaN in); overflow gives infinity. */
static unsigned short nx_half(double v) {
  unsigned s = v < 0 ? 0x8000 : 0;
  int e;
  double m;
  if (v < 0) v = -v;
  if (v < 5.960464477539063e-8 / 2) return s;
  m = frexp(v, &e);                                  /* v = m * 2^e, 0.5 <= m < 1 */
  if (e > 16) return s | 0x7C00;
  if (e < -13) return s | (unsigned)(v / 5.960464477539063e-8 + 0.5);   /* subnormal */
  {
    unsigned f = (unsigned)((m * 2 - 1) * 1024 + 0.5);
    if (f == 1024) { f = 0; e++; }
    if (e > 16) return s | 0x7C00;
    return s | ((unsigned)(e + 14) << 10) | f;
  }
}

/* rgba (w x h) + gain map rgba (gw x gh) -> nx_out. mode 0: 16-bit big-endian RGB, PQ; 1: the same
   with one PNG filter byte (0) before each row; 2: native half floats, linear, 1.0 = SDR white
   (203 nits), BT.709 primaries (p3: converted from Display P3; out-of-gamut values go negative). */
static void nx_apply(const unsigned char *rgba, int w, int h, const unsigned char *gm, int gw, int gh, int mode, int p3) {
  static const double M[9] = { 1.2249401, -0.2249404, 0, -0.0420569, 1.0420571, 0, -0.0196376, -0.0786361, 1.0982735 };
  double lin[256], lut[256];
  long o;
  int x, y, c, i;
  for (i = 0; i < 256; i++) {
    lin[i] = nx_srgb(i / 255.0);
    lut[i] = pow(2, nx_min + (nx_max - nx_min) * pow(i / 255.0, 1 / nx_gamma));
  }
  nx_n = 0;
  if (nx_cap < (long)h * (w * 6 + 1)) { nx_cap = (long)h * (w * 6 + 1); nx_out = realloc(nx_out, nx_cap); }
  o = 0;
  for (y = 0; y < h; y++) {
    double fy = (y + 0.5) * gh / h - 0.5;
    int y0 = fy < 0 ? 0 : (int)fy, y1 = y0 + 1 < gh ? y0 + 1 : gh - 1;
    double ty = fy < 0 ? 0 : fy - y0;
    if (mode == 1) nx_out[o++] = 0;
    for (x = 0; x < w; x++) {
      double v3[3];
      double fx = (x + 0.5) * gw / w - 0.5;
      int x0 = fx < 0 ? 0 : (int)fx, x1 = x0 + 1 < gw ? x0 + 1 : gw - 1;
      double tx = fx < 0 ? 0 : fx - x0;
      for (c = 0; c < 3; c++) {
        double g = (1 - ty) * ((1 - tx) * lut[gm[((long)y0 * gw + x0) * 4 + c]] + tx * lut[gm[((long)y0 * gw + x1) * 4 + c]])
                 + ty * ((1 - tx) * lut[gm[((long)y1 * gw + x0) * 4 + c]] + tx * lut[gm[((long)y1 * gw + x1) * 4 + c]]);
        double v = (lin[rgba[((long)y * w + x) * 4 + c]] + nx_osdr) * g - nx_ohdr;
        if (mode == 2) { v3[c] = v; continue; }
        int q = (int)(nx_pq(v < 0 ? 0 : v * 203) * 65535 + 0.5);
        nx_out[o++] = q >> 8;
        nx_out[o++] = q;
      }
      if (mode == 2)
        for (c = 0; c < 3; c++) {
          double v = p3 ? M[c * 3] * v3[0] + M[c * 3 + 1] * v3[1] + M[c * 3 + 2] * v3[2] : v3[c];
          *(unsigned short *)(nx_out + o) = nx_half(v);
          o += 2;
        }
    }
  }
  nx_n = o;
}
`;

Public

  // ISO 21496-1 metadata m[0, n) -> the parameters below. False: unknown version.
  - parse m:C_array Uint8 from p:Int size n:Int :Boolean <- `nx_parse(@m + @p, @n)`:Int != 0

  // Alternate (HDR) headroom in hundredths of a stop, for `nova info`.
  - headroom_centistops:Int <- `(int)(nx_halt * 100 + 0.5)`:Int

  - gain_map_xmp <- ( `nx_xmp_gm()`; )

  // With the source's XMP packet x[p, p + n) (n 0: none).
  - primary_xmp gn:Int source (x:C_array Uint8, p,n:Int) <- ( `nx_xmp_primary(@gn, @x + @p, @n)`; )

  - ultrahdr (p:C_array Uint8, pn:Int) gain_map (g:C_array Uint8, gn:Int) <- ( `nx_ultrahdr(@p, @pn, @g, @gn)`; )

  // HDR rendition, 16-bit big-endian RGB PQ (png: with PNG filter bytes).
  - apply rgba:C_array Uint8 size (w,h:Int) gain_map gm:C_array Uint8 gain_size (gw,gh:Int) png pg:Boolean <-
  ( + p:Int
    p := pg.to_int
    `nx_apply(@rgba, @w, @h, @gm, @gw, @gh, @p, 0)`;
  )

  // HDR rendition as native half floats (RGB), linear, 1.0 = SDR white, BT.709 primaries (p3: the
  // pixels are Display P3).
  - apply_linear rgba:C_array Uint8 size (w,h:Int) gain_map gm:C_array Uint8 gain_size (gw,gh:Int) p3 d:Boolean <-
  ( + p:Int
    p := d.to_int
    `nx_apply(@rgba, @w, @h, @gm, @gw, @gh, 2, @p)`;
  )

  // Result of the last call (XMP text, Ultra HDR file or HDR pixels).
  - data:C_array Uint8 <- `nx_out`:C_array Uint8

  - size:Int <- `nx_n`:Int
