Header
  + name := Nova_rawin
  // Camera RAW import through LibRaw, loaded at run time (dlopen): nova runs without it (RAW is then
  // refused). Only the struct layout comes from the vendored headers (third_party/libraw, 0.22):
  // the library must be the same minor version, checked at load.
  // Keeps the sensor frame as it is (CFA samples, masked borders included, no black subtraction),
  // the parameters a DNG needs (RAWH chunk) and, for CR3, the EXIF of the CMT1-4 boxes.
  // ponytail: Bayer CFA with raw_image only; Foveon, sRAW/mRAW, linear DNG, X-Trans and
  // 4-colour layouts are refused. Other makers' EXIF (TIFF-based raws) is not kept yet.
  - include := `
#include <dlfcn.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <math.h>
#include "third_party/libraw/libraw/libraw.h"
#include "nova_look.h"
`;
  - external := `
static void *nr_lib;
static __typeof__(libraw_init) *nr_init;
static __typeof__(libraw_open_file) *nr_open_file;
static __typeof__(libraw_unpack) *nr_unpack;
static __typeof__(libraw_close) *nr_close;
static __typeof__(libraw_versionNumber) *nr_version;
static __typeof__(libraw_strerror) *nr_strerror;
static __typeof__(libraw_open_buffer) *nr_open_buf;
static __typeof__(libraw_dcraw_process) *nr_process;
static __typeof__(libraw_dcraw_make_mem_image) *nr_mem_image;
static __typeof__(libraw_dcraw_clear_mem) *nr_clear_mem;

static const char *nr_msg;

static int nr_open(void) {
  if (nr_lib) return 1;
  nr_lib = dlopen("libraw_r.so.25", RTLD_NOW | RTLD_LOCAL);
  if (!nr_lib) nr_lib = dlopen("libraw_r.so", RTLD_NOW | RTLD_LOCAL);
  if (!nr_lib) nr_lib = dlopen("libraw_r.dylib", RTLD_NOW | RTLD_LOCAL);
  if (!nr_lib) { nr_msg = "libraw not found (install LibRaw 0.22)"; return 0; }
#define NR(v, s) if (!(*(void **)&v = dlsym(nr_lib, s))) { nr_msg = "libraw: missing " s; nr_lib = 0; return 0; }
  NR(nr_init, "libraw_init") NR(nr_open_file, "libraw_open_file") NR(nr_unpack, "libraw_unpack")
  NR(nr_close, "libraw_close") NR(nr_version, "libraw_versionNumber") NR(nr_strerror, "libraw_strerror")
  NR(nr_open_buf, "libraw_open_buffer") NR(nr_process, "libraw_dcraw_process")
  NR(nr_mem_image, "libraw_dcraw_make_mem_image") NR(nr_clear_mem, "libraw_dcraw_clear_mem")
#undef NR
  /* The structs are read directly: same major.minor as the vendored headers. */
  if ((nr_version() >> 8) != (LIBRAW_VERSION >> 8)) { nr_msg = "libraw version differs from 0.22 (see third_party/libraw)"; nr_lib = 0; return 0; }
  return 1;
}

/* Results of the last nr_load: frame, RAWH payload, metadata blocks [u32 kind][u32 length][data]. */
static int nr_w, nr_h;
static unsigned short *nr_px;
static unsigned char *nr_buf[2];
static long nr_n[2], nr_cap[2];

static void nr_put(int k, const void *p, long n) {
  if (nr_n[k] + n > nr_cap[k]) {
    nr_cap[k] = (nr_n[k] + n) * 2 + 1024;
    nr_buf[k] = realloc(nr_buf[k], nr_cap[k]);
  }
  memcpy(nr_buf[k] + nr_n[k], p, n);
  nr_n[k] += n;
}

static void nr_put32(int k, unsigned long v) {
  unsigned char b[4] = { v >> 24, v >> 16, v >> 8, v };
  nr_put(k, b, 4);
}

static void nr_putf(int k, float f) {
  unsigned int u;
  memcpy(&u, &f, 4);
  nr_put32(k, u);
}

static void nr_str(int k, const char *s) {
  unsigned char n = strnlen(s, 64);
  nr_put(k, &n, 1);
  nr_put(k, s, n);
}

/* RAWH, big-endian: [1 version][u32 top left width height][u32 filters][4 cdesc][u32 flip]
   [u32 black maximum][u32 cblack count n][n x u32 cblack][f32 cam_mul 4, pre_mul 4, cam_xyz 4x3,
   rgb_cam 3x4][f32 iso shutter aperture focal][u32 timestamp][make][model] (strings: u8 length)
   [u32 linear_max 4]: the real saturation level (Canon: from the maker notes; 0 when unknown). */
/* Level 6 reads black (offset 29) and cblack[0] (offset 41) here (Nova.raw_black): a field added
   before them, or any layout change, needs a new version byte (the decoder refuses other versions). */
static void nr_head(libraw_data_t *r) {
  unsigned char v = 1;
  int i, j, n;
  nr_put(0, &v, 1);
  nr_put32(0, r->sizes.top_margin); nr_put32(0, r->sizes.left_margin);
  nr_put32(0, r->sizes.width); nr_put32(0, r->sizes.height);
  nr_put32(0, r->idata.filters);
  nr_put(0, r->idata.cdesc, 4);
  nr_put32(0, r->sizes.flip);
  nr_put32(0, r->color.black); nr_put32(0, r->color.maximum);
  n = 6 + r->color.cblack[4] * r->color.cblack[5];
  if (n > LIBRAW_CBLACK_SIZE) n = LIBRAW_CBLACK_SIZE;
  nr_put32(0, n);
  for (i = 0; i < n; i++) nr_put32(0, r->color.cblack[i]);
  for (i = 0; i < 4; i++) nr_putf(0, r->color.cam_mul[i]);
  for (i = 0; i < 4; i++) nr_putf(0, r->color.pre_mul[i]);
  for (i = 0; i < 4; i++) for (j = 0; j < 3; j++) nr_putf(0, r->color.cam_xyz[i][j]);
  for (i = 0; i < 3; i++) for (j = 0; j < 4; j++) nr_putf(0, r->color.rgb_cam[i][j]);
  nr_putf(0, r->other.iso_speed); nr_putf(0, r->other.shutter);
  nr_putf(0, r->other.aperture); nr_putf(0, r->other.focal_len);
  nr_put32(0, (unsigned long)r->other.timestamp);
  nr_str(0, r->idata.make);
  nr_str(0, r->idata.model);
  for (i = 0; i < 4; i++) nr_put32(0, r->color.linear_max[i]);
}

/* CR3: the CMT1..CMT4 boxes (TIFF streams: IFD0, Exif IFD, maker notes, GPS) of the moov uuid box.
   ponytail: found by scanning the first 1 MB for [size][CMTn][II*0 or MM0*] instead of walking the box tree. */
static void nr_cmt(const char *name) {
  FILE *f = fopen(name, "rb");
  unsigned char *b;
  long n, i, sz;
  if (!f) return;
  b = malloc(1 << 20);
  n = b ? fread(b, 1, 1 << 20, f) : 0;
  fclose(f);
  if (n < 12 || memcmp(b + 4, "ftypcrx ", 8)) { free(b); return; }
  for (i = 4; i + 8 <= n; i++) {
    if (b[i] != 'C' || b[i + 1] != 'M' || b[i + 2] != 'T' || b[i + 3] < '1' || b[i + 3] > '4') continue;
    sz = (long)b[i - 4] << 24 | b[i - 3] << 16 | b[i - 2] << 8 | b[i - 1];
    if (sz < 16 || i - 4 + sz > n) continue;
    if (memcmp(b + i + 4, "II*", 4) && memcmp(b + i + 4, "MM\0*", 4)) continue;
    nr_put32(1, 0x434D5430 + (b[i + 3] - '0'));
    nr_put32(1, sz - 8);
    nr_put(1, b + i + 4, sz - 8);
    i += sz - 5;
  }
  free(b);
}

/* 1 on success, else 0 with nr_msg set. */
static int nr_load(const char *name) {
  libraw_data_t *r;
  int e, y;
  nr_n[0] = nr_n[1] = 0;
  free(nr_px);
  nr_px = 0;
  if (!nr_open()) return 0;
  r = nr_init(0);
  if (!r) { nr_msg = "libraw_init failed"; return 0; }
  e = nr_open_file(r, name);
  if (!e) e = nr_unpack(r);
  if (e) { nr_msg = nr_strerror(e); nr_close(r); return 0; }
  if (!r->rawdata.raw_image || !r->idata.filters || r->idata.filters < 1000 || r->idata.colors != 3) {
    nr_msg = "unsupported RAW layout (only Bayer CFA)";
    nr_close(r);
    return 0;
  }
  nr_w = r->sizes.raw_width;
  nr_h = r->sizes.raw_height;
  nr_px = malloc((size_t)nr_w * nr_h * 2);
  if (!nr_px) { nr_msg = "out of memory"; nr_close(r); return 0; }
  for (y = 0; y < nr_h; y++) memcpy(nr_px + (size_t)y * nr_w, (char *)r->rawdata.raw_image + (size_t)y * r->sizes.raw_pitch, (size_t)nr_w * 2);
  nr_head(r);
  nr_cmt(name);
  nr_close(r);
  return 1;
}

/* RAWH floats (f32 bits) -> scaled integers, for the DNG rationals. */
static long nr_fix(unsigned int bits, double scale) {
  float f;
  memcpy(&f, &bits, 4);
  return lrint(f * scale);
}

static long nr_ratio(unsigned int a, unsigned int b, double scale) {
  float fa, fb;
  memcpy(&fa, &a, 4);
  memcpy(&fb, &b, 4);
  return fb == 0 ? 0 : lrint(scale * fa / fb);
}

/* Development: LibRaw's dcraw_process (camera white balance, sRGB primaries, AHD, linear, no
   automatic brightness), then a tone curve of nova_look.h (look 0 canon, 1 darktable); rotated by the camera
   orientation. From a file (name) or a buffer (our DNG). bits 8: RGBA bytes in nr_dev; bits 16: RGB
   unsigned shorts (native order) in nr_dev. half: half size (one pixel per CFA block, for the
   preview). 1 on success, else 0 with nr_msg set.
   ponytail: no highlight recovery, no noise reduction, no lens corrections. */
static int nr_dw, nr_dh;
static unsigned char *nr_dev;
static unsigned short *nr_lut[2];
static unsigned nr_be(const unsigned char *p) { return (unsigned)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; }
static float nr_bf(const unsigned char *p) { unsigned u = nr_be(p); float f; memcpy(&f, &u, 4); return f; }

/* rh: RAWH payload (or 0). LibRaw reads the DNG tags with less precision than it has for the
   source (rational colour matrix, white balance); its own values from RAWH are put back, so the
   development matches the source file's. */
static void nr_restore(libraw_data_t *r, const unsigned char *rh) {
  int i, j, n = nr_be(rh + 37);
  const unsigned char *f = rh + 41 + 4 * n;
  r->color.black = nr_be(rh + 29);
  r->color.maximum = nr_be(rh + 33);
  memset(r->color.cblack, 0, sizeof r->color.cblack);
  for (i = 0; i < n && i < LIBRAW_CBLACK_SIZE; i++) r->color.cblack[i] = nr_be(rh + 41 + 4 * i);
  for (i = 0; i < 4; i++) r->color.cam_mul[i] = nr_bf(f + 4 * i);
  for (i = 0; i < 4; i++) r->color.pre_mul[i] = nr_bf(f + 16 + 4 * i);
  for (i = 0; i < 4; i++) for (j = 0; j < 3; j++) r->color.cam_xyz[i][j] = nr_bf(f + 32 + 4 * (i * 3 + j));
  for (i = 0; i < 3; i++) for (j = 0; j < 4; j++) r->color.rgb_cam[i][j] = nr_bf(f + 80 + 4 * (i * 4 + j));
  /* dcraw_process starts from the copy made at unpack. */
  memcpy(&r->rawdata.color, &r->color, sizeof r->color);
}

static int nr_develop(const char *name, const void *buf, long n, const unsigned char *rh, int bits, int half, int look) {
  unsigned short *lut;
  libraw_data_t *r;
  libraw_processed_image_t *im;
  int e = 0;
  long i, np;
  free(nr_dev);
  nr_dev = 0;
  nr_msg = 0;
  if (!nr_open()) return 0;
  r = nr_init(0);
  if (!r) { nr_msg = "libraw_init failed"; return 0; }
  if (!nr_lut[look] && (nr_lut[look] = malloc(65536 * 2))) for (i = 0; i < 65536; i++) nr_lut[look][i] = nova_look_map(i, look);
  if (!(lut = nr_lut[look])) { nr_msg = "out of memory"; return 0; }
  r->params.use_camera_wb = 1;
  r->params.output_bps = 16;
  r->params.half_size = half;
  r->params.no_auto_bright = 1;
  r->params.gamm[0] = 1;
  r->params.gamm[1] = 1;
  e = name ? nr_open_file(r, name) : nr_open_buf(r, buf, n);
  if (!e) e = nr_unpack(r);
  if (!e && rh) nr_restore(r, rh);
  if (!e) e = nr_process(r);
  im = e ? 0 : nr_mem_image(r, &e);
  if (!im) { nr_msg = e ? nr_strerror(e) : "libraw: no image"; nr_close(r); return 0; }
  nr_dw = im->width;
  nr_dh = im->height;
  np = (long)nr_dw * nr_dh;
  if (im->colors != 3 || im->bits != 16) { nr_msg = "libraw: unexpected image layout"; }
  else if (bits == 16) {
    unsigned short *d = malloc(np * 6);
    const unsigned short *p = (const unsigned short *)im->data;
    if ((nr_dev = (unsigned char *)d)) for (i = 0; i < np; i++) nova_look_rgb(lut, p + i * 3, d + i * 3, look);
  } else if ((nr_dev = malloc(np * 4))) {
    const unsigned short *p = (const unsigned short *)im->data;
    unsigned short o[3];
    for (i = 0; i < np; i++) {
      nova_look_rgb(lut, p + i * 3, o, look);
      nr_dev[i * 4] = (o[0] + 128) / 257;
      nr_dev[i * 4 + 1] = (o[1] + 128) / 257;
      nr_dev[i * 4 + 2] = (o[2] + 128) / 257;
      nr_dev[i * 4 + 3] = 255;
    }
  }
  nr_clear_mem(im);
  nr_close(r);
  if (!nr_dev && !nr_msg) nr_msg = "out of memory";
  return nr_dev != 0;
}

/* LibRaw can open this file (header only: no unpack). */
static int nr_probe(const char *name) {
  libraw_data_t *r;
  int ok;
  if (!nr_open()) return 0;
  r = nr_init(0);
  ok = r && nr_open_file(r, name) == 0;
  if (r) nr_close(r);
  return ok;
}
`;

Public

  - is_raw name:String :Boolean <-
  ( + pe:C_array Char
    pe := name.to_external
    `nr_probe((char *)@pe)`:Int != 0
  )

  - load name:String :Boolean <-
  // Then width, height, sample, head*, meta*, message.
  ( + pe:C_array Char
    pe := name.to_external
    `nr_load((char *)@pe)`:Int != 0
  )

  - width:Int <- `nr_w`:Int

  - height:Int <- `nr_h`:Int

  - sample i:Int :Int <- `nr_px[@i]`:Int

  // RAWH payload and metadata blocks ([u32 kind][u32 length][payload]) of the last load.
  - head:C_array Uint8 <- `nr_buf[0]`:C_array Uint8

  - head_size:Int <- `nr_n[0]`:Int

  - meta:C_array Uint8 <- `nr_buf[1]`:C_array Uint8

  - meta_size:Int <- `nr_n[1]`:Int

  // f32 bits x scale, rounded; a / b x scale (0 when b = 0).
  - fixed bits:Int scale sc:Int :Int <- `nr_fix(@bits, @sc)`:Int

  - ratio (a,b:Int) scale sc:Int :Int <- `nr_ratio(@a, @b, @sc)`:Int

  // Developed image (see nr_develop): from the file name, or from buf[0, n) (a DNG).
  - develop name:String bits b:Int half h:Boolean :Boolean <-
  ( + pe:C_array Char
    + hi:Int
    pe := name.to_external
    hi := h.to_int
    `nr_develop((char *)@pe, 0, 0, 0, @b, @hi, 0)`:Int != 0
  )

  // rawh: the RAWH payload at head[rh] (LibRaw's own parameters, see nr_restore).
  // look: 0 canon (camera JPEG), 1 darktable.
  - develop_buffer buf:C_array Uint8 size n:Int rawh (head:C_array Uint8, rh:Int) bits b:Int look lk:Int :Boolean <- `nr_develop(0, @buf, @n, @head + @rh, @b, 0, @lk)`:Int != 0

  - image:C_array Uint8 <- `nr_dev`:C_array Uint8

  - image_width:Int <- `nr_dw`:Int

  - image_height:Int <- `nr_dh`:Int

  - message:String <-
  ( + result:String_buffer
    result := String_buffer.create 64
    result.from_external_copy (`nr_msg`:C_array Char)
    result.to_string
  )
