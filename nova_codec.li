Header
  + name := Nova_codec
  // NOVA v2 lossless frame coder: planes G, R-G+255, B-G+255, A (no wrap), coded pixel by pixel,
  // MED prediction, residuals binarized and coded by Nova_model (context mixing).
  // Also owns the output byte buffer.

Public

  //
  // Output buffer
  //

  - out:C_array Uint8 := C_array Uint8.create 65536

  - out_cap:Int := 65536

  - out_count:Int

  - reset_out <- ( out_count := 0; )

  - truncate_out n:Int <- ( out_count := n; )

  - put_byte v:Int <-
  (
    (out_count = out_cap).if {
      out := out.realloc out_cap with (out_cap * 2)
      out_cap := out_cap * 2
    }
    out.at out_count put ((v & 255).to_uint8)
    out_count := out_count + 1
  )

  - put_u16 v:Int <-
  (
    put_byte (v >> 8)
    put_byte v
  )

  - put_u32 v:Int <-
  (
    put_byte (v >> 24)
    put_byte (v >> 16)
    put_byte (v >> 8)
    put_byte v
  )

  - set_u32 v:Int at pos:Int <-
  ( + save:Int
    save := out_count
    out_count := pos
    put_u32 v
    out_count := save
  )

  //
  // Pixel access: RGBA buffer, region (ox,oy,w,h) inside an image of width stride.
  //

  - px:C_array Uint8

  - stride:Int

  - ox:Int

  - oy:Int

  - w:Int

  - h:Int

  - sample p:Int at (x,y:Int) :Int <-
  ( + i,g,result:Int
    i := ((oy + y) * stride + ox + x) * 4
    g := (px.at (i + 1)).to_int
    (pmode).if {
      result := ibuf.at (y * w + x)
    }.elseif {p = 0} then {
      result := g
    }.elseif {p = 1} then {
      result := (px.at i).to_int - g + 255
    }.elseif {p = 2} then {
      result := (px.at (i + 2)).to_int - g + 255
    } else {
      result := (px.at (i + 3)).to_int
    }
    result
  )

  - store v:Int plane p:Int at (x,y:Int) <-
  // Plane 0 (G) of a pixel is always decoded first, so R and B can be rebuilt from it.
  // A corrupt stream can give R or B out of 0..255: & 255 keeps the byte, CRC catches the file.
  ( + i:Int
    i := ((oy + y) * stride + ox + x) * 4
    (pmode).if {
      ibuf.at (y * w + x) put v
    }.elseif {p = 0} then {
      px.at (i + 1) put (v.to_uint8)
    }.elseif {p = 1} then {
      px.at i put (((v - 255 + (px.at (i + 1)).to_int) & 255).to_uint8)
    }.elseif {p = 2} then {
      px.at (i + 2) put (((v - 255 + (px.at (i + 1)).to_int) & 255).to_uint8)
    } else {
      px.at (i + 3) put (v.to_uint8)
    }
  )

  // Plane values of the last 4 rows of the region (ring), written as each sample is coded:
  // neighbours are read here instead of being rebuilt from the RGBA buffer.
  - rbuf:C_array Int := C_array Int.create 16

  - nb p:Int at (x,y:Int) :Int <- rbuf.at ((((y & 3) * w) + x) * 4 + p)

  // Causal neighbours: a left, b up, c up-left, d up-right, aa left-left, bb up-up.
  - ra:Int

  - rb:Int

  - rc:Int

  - rd:Int

  - raa:Int

  - rbb:Int

  - neighbours p:Int at (x,y:Int) <-
  (
    (y = 0).if {
      ra := 0
      (x > 0).if { ra := nb p at (x - 1, 0) }
      rb := ra
      rc := ra
      rd := ra
    } else {
      rb := nb p at (x, y - 1)
      (x > 0).if {
        ra := nb p at (x - 1, y)
        rc := nb p at (x - 1, y - 1)
      } else {
        ra := rb
        rc := rb
      }
      (x < w - 1).if {
        rd := nb p at (x + 1, y - 1)
      } else {
        rd := rb
      }
    }
    raa := ra
    (x > 1).if { raa := nb p at (x - 2, y) }
    rbb := rb
    (y > 1).if { rbb := nb p at (x, y - 2) }
  )

  - predict:Int <-
  // MED (median edge detector).
  ( + mx,mn,result:Int
    mx := ra
    mn := rb
    (rb > ra).if {
      mx := rb
      mn := ra
    }
    (rc >= mx).if {
      result := mn
    }.elseif {rc <= mn} then {
      result := mx
    } else {
      result := ra + rb - rc
    }
    result
  )

  //
  // Signed residuals of the previous and current rows (for the error-energy context).
  //

  - ebuf:C_array Int := C_array Int.create 8

  - ecap:Int := 8

  - err_at p:Int at (x,y:Int) :Int <- ebuf.at ((((y & 1) * w) + x) * 4 + p)

  // qlog and qhalf of 0..4095, filled once (they run several times per sample).
  - ql_t:C_array Int := C_array Int.create 4096

  - qh_t:C_array Int := C_array Int.create 4096

  - qtables_ready:Boolean

  - make_qtables <-
  (
    0.to 4095 do { v:Int
      ql_t.at v put (qlog_slow v)
      qh_t.at v put (qhalf_slow v)
    }
    qtables_ready := True
  )

  - qlog v:Int :Int <-
  ( + result:Int
    result := 7
    (v < 4096).if { result := ql_t.at v }
    result
  )

  - qhalf v:Int :Int <-
  ( + result:Int
    result := 15
    (v < 4096).if { result := qh_t.at v }
    result
  )

  - qlog_slow v:Int :Int <-
  // 0, 1, 2-3, 4-7, ... 64+ -> 0..7
  ( + a,result:Int
    a := v
    {(a > 0) && {result < 7}}.while_do {
      result := result + 1
      a := a >> 1
    }
    result
  )

  //
  // Prediction: blend of 5 predictors, each weighted by 1/(8+s) where s = its recent errors
  // on the causal neighbours. Mostly a smoother: on grainy photos averaging beats any single one.
  //

  - pbuf:C_array Int := C_array Int.create 48

  - sp:C_array Int := C_array Int.create 6

  - perr p:Int pred k:Int at (x,y:Int) :Int <- pbuf.at ((((((y & 1) * w) + x) * 4 + p) * 6) + k)

  //
  // Predictors 4 and 5: normalized LMS on causal samples, as differences to W, weights per plane
  // in 16.16 learned online. Tap set 0 (level 3+): 2 left + 5 on each of the 2 rows above (11).
  // Tap set 1 (level 4): 3 left + 7 on each of the 3 rows above (24). Best on grainy photos.
  //

  - tdx:C_array Int := C_array Int.create 35

  - tdy:C_array Int := C_array Int.create 35

  - taps_ready:Boolean

  - tap k:Int is (dx,dy:Int) <-
  (
    tdx.at k put dx
    tdy.at k put dy
  )

  - make_taps <-
  ( + k:Int
    tap 0 is (-2, 0)
    0.to 4 do { i:Int
      tap (1 + i) is (i - 2, -1)
      tap (6 + i) is (i - 2, -2)
    }
    tap 11 is (-3, 0)
    tap 12 is (-2, 0)
    tap 13 is (-1, 0)
    k := 14
    1.to 3 do { r:Int
      0.to 6 do { i:Int
        tap k is (i - 3, - r)
        k := k + 1
      }
    }
    taps_ready := True
  )

  // Per tap set j: first tap, tap count, margin needed around the pixel.
  - tfirst j:Int :Int <- j * 11

  - tcount j:Int :Int <- 11 + j * 13

  - margin j:Int :Int <- 2 + j

  // Weights: (j * 4 + plane) * 24 + tap. Differences of the current sample: j * 24 + tap.
  - lw:C_array Int := C_array Int.create 192

  - ld:C_array Int := C_array Int.create 48

  - nl_on:C_array Int := C_array Int.create 2

  - nlms j:Int plane p:Int at (x,y:Int) :Int <-
  ( + wv,dot,m,result:Int
    result := sp.at 0
    m := margin j
    nl_on.at j put 0
    ((y >= m) && {x >= m} && {x < w - m}).if {
      nl_on.at j put 1
      wv := nb p at (x - 1, y)
      0.to (tcount j - 1) do { k:Int
        ld.at (j * 24 + k) put ((nb p at (x + (tdx.at (tfirst j + k)), y + (tdy.at (tfirst j + k)))) - wv)
        dot := dot + (lw.at ((j * 4 + p) * 24 + k)) * (ld.at (j * 24 + k))
      }
      result := wv + (dot >> 16)
    }
    result
  )

  - nlms_update j:Int plane p:Int value v:Int <-
  // mu = 0.032: w += mu * err * d / (|d|^2 + 16).
  ( + en,f,n:Int
    ((nl_on.at j) = 1).if {
      n := tcount j
      en := 16
      0.to (n - 1) do { k:Int
        en := en + (ld.at (j * 24 + k)) * (ld.at (j * 24 + k))
      }
      f := ((v - (sp.at (4 + j))) * 2097 * 1024) / en
      0.to (n - 1) do { k:Int
        lw.at ((j * 4 + p) * 24 + k) put ((lw.at ((j * 4 + p) * 24 + k)) + ((f * (ld.at (j * 24 + k))) >> 10))
      }
    }
  )

  // Blend size: 5 predictors at level 3, 6 at level 4.
  - npred:Int

  - blend p:Int at (x,y:Int) :Int <-
  ( + s,wk,sw,sum:Int
    sp.at 0 put predict
    sp.at 1 put ((ra + rb + 1) >> 1)
    sp.at 2 put (ra + rb - rc)
    sp.at 3 put ((ra + rd + 1) >> 1)
    sp.at 4 put (nlms 0 plane p at (x, y))
    (npred = 6).if { sp.at 5 put (nlms 1 plane p at (x, y)) }
    0.to (npred - 1) do { k:Int
      s := 0
      (x > 0).if { s := s + perr p pred k at (x - 1, y) }
      (y > 0).if {
        s := s + perr p pred k at (x, y - 1)
        (x > 0).if { s := s + perr p pred k at (x - 1, y - 1) }
        (x < w - 1).if { s := s + perr p pred k at (x + 1, y - 1) }
      }
      wk := (1 << 30) / (8 + s)
      sw := sw + wk
      sum := sum + wk * (sp.at k)
    }
    (sum + (sw >> 1)) / sw
  )

  //
  // Cross-colour: the chroma residual is regressed online on the G residual of the same pixel
  // (least squares with a ~1024-sample memory), and that share is added to the prediction.
  //

  - ccn:C_array Int := C_array Int.create 4

  - ccd:C_array Int := C_array Int.create 4

  - cross p:Int :Int <-
  // Slope in 1/64, clamped to [-2, 2].
  ( + c:Int
    c := ((ccn.at p) * 64) / ((ccd.at p) + 64)
    (c < -128).if { c := -128 }
    (c > 128).if { c := 128 }
    c
  )

  // Values of the planes already coded for the current pixel.
  - cur:C_array Int := C_array Int.create 4

  - set_contexts p:Int at (x,y:Int) pred pr:Int <-
  ( + g,act,ew,en,ene,enw,sew,sen,q1,q2:Int
    g := (rd - rb).abs + (rb - rc).abs + (rc - ra).abs
    act := qlog g
    (g >= 128).if { act := 8 + (qlog (g >> 7)) }
    ew := 0
    en := 0
    ene := 0
    enw := 0
    sew := 0
    sen := 0
    (x > 0).if { sew := err_at p at (x - 1, y) }
    (y > 0).if {
      sen := err_at p at (x, y - 1)
      ene := sen.abs
      enw := ene
      (x < w - 1).if { ene := (err_at p at (x + 1, y - 1)).abs }
      (x > 0).if { enw := (err_at p at (x - 1, y - 1)).abs }
    }
    ew := sew.abs
    en := sen.abs
    q1 := qlog (ew + en)
    (p = 0).if { q2 := qlog (ene + enw) } else { q2 := qlog ((err_at 0 at (x, y)).abs) }
    Nova_model.ctx.at 0 put ((p * 16 + act) * 80)
    Nova_model.ctx.at 1 put (5120 + ((p * 16 + (qhalf (2 * (ew + en) + ene + enw))) * 8 + q2) * 80)
    Nova_model.set_weights (p * 4 + (act >> 2)) and (p * 8 + q1) and (p * 8 + q2) apm ((p * 16 + act) * 10)
    (level >= 2).if { hashed_contexts p pred pr with (act, q1, q2, sew, sen) at (x, y) }
  )

  - hashed_contexts p:Int pred pr:Int with (act,q1,q2,sew,sen:Int) at (x,y:Int) <-
  ( + h3,h4,h5,h6,h7:Int
    h3 := Nova_model.hash (p + 1) with ra
    h3 := Nova_model.hash h3 with rb
    h3 := Nova_model.hash h3 with rc
    h3 := Nova_model.hash h3 with rd
    // The prediction depends on hidden state (recent errors): hash it so the residual stays consistent.
    h3 := Nova_model.hash h3 with pr
    h4 := Nova_model.hash (p + 11) with h3
    h4 := Nova_model.hash h4 with raa
    h4 := Nova_model.hash h4 with rbb
    h5 := Nova_model.hash (p + 21) with ra
    h5 := Nova_model.hash h5 with rb
    0.to (p - 1) do { i:Int
      h4 := Nova_model.hash h4 with (cur.at i)
      h5 := Nova_model.hash h5 with (cur.at i)
    }
    h5 := Nova_model.hash h5 with pr
    (p = 0).if { h5 := Nova_model.hash h5 with (act * 8 + q1) }
    // m5: where the neighbours sit around the prediction (a second predictor, in effect).
    h6 := Nova_model.hash (p + 31) with (sq (ra - pr))
    h6 := Nova_model.hash h6 with (sq (rb - pr))
    h6 := Nova_model.hash h6 with (sq (rc - pr))
    h6 := Nova_model.hash h6 with (sq (rd - pr))
    // m6: signed errors of the neighbours and of plane 0 of this pixel.
    h7 := Nova_model.hash (p + 41) with (sq sew)
    h7 := Nova_model.hash h7 with (sq sen)
    (p = 0).if { h7 := Nova_model.hash h7 with q2 } else { h7 := Nova_model.hash h7 with (sq (err_at 0 at (x, y))) }
    Nova_model.ctx.at 2 put h3
    Nova_model.ctx.at 3 put h4
    Nova_model.ctx.at 4 put h5
    Nova_model.ctx.at 5 put h6
    Nova_model.ctx.at 6 put h7
  )

  - qhalf_slow v:Int :Int <-
  // Half-octave quantization: 0 1 2 3 4-5 6-7 8-11 12-15 ... -> 0..15.
  ( + a,result:Int
    (v < 4).if {
      result := v
    } else {
      a := v
      result := 0
      {a >= 8}.while_do {
        result := result + 2
        a := a >> 1
      }
      result := result + 4
      (a >= 6).if { result := result + 1 }
      (result > 15).if { result := 15 }
    }
    result
  )

  - sq v:Int :Int <-
  // Signed log quantization: -8..8.
  ( + result:Int
    (v < 0).if { result := - (qlog (- v)) } else { result := qlog v }
    result
  )

  //
  // Residual binarization: zero flag, sign, exponent n (unary, 0..7), n mantissa bits.
  //

  // Expected residual from the match model; none = no match.
  - none:Int := 100000

  - code_residual e:Int expect er:Int :Int <-
  // Encoder: codes e, returns it. Decoder: e ignored, returns the decoded residual.
  // er: residual the matched pixel predicts; each decision gets the bit it implies as a hint,
  // until a decoded bit disagrees.
  // Hashed buckets: group 0 = zero, sign, exponent; then the first 4 mantissa bits (tree
  // offsets 1..15), then the last 3 in a bucket keyed by the 4 first.
  ( + s,a,n,tn,en,ea,prefix,off,b,hv,result:Int
    ea := er.abs
    {(ea >> (en + 1)) > 0}.while_do { en := en + 1 }
    hv := -1
    (er != none).if { hv := (er != 0).to_int }
    Nova_model.group 0
    b := Nova_model.bit ((e != 0).to_int) node 0 slot 0 hint hv
    (b != hv).if { hv := -1 }
    (b = 1).if {
      (hv >= 0).if { hv := (er < 0).to_int }
      s := Nova_model.bit ((e < 0).to_int) node 1 slot 1 hint hv
      (s != hv).if { hv := -1 }
      a := e.abs
      {(a >> (tn + 1)) > 0}.while_do { tn := tn + 1 }
      {(n < 7) && {
        (hv >= 0).if { hv := (n < en).to_int }
        b := Nova_model.bit ((n < tn).to_int) node (2 + n) slot (2 + n + 7 * s) hint hv
        (b != hv).if { hv := -1 }
        b = 1
      }}.while_do {
        n := n + 1
      }
      (n > 0).if { Nova_model.group (1 + s * 8 + n) }
      prefix := 1
      off := 1
      (n - 1).downto 0 do { i:Int
        (off >= 16).if {
          Nova_model.group (256 + (s * 8 + n) * 32 + prefix)
          off := 1
        }
        (hv >= 0).if { hv := (ea >> i) & 1 }
        b := Nova_model.bit ((a >> i) & 1) node (16 + 8 * n + i) slot off hint hv
        (b != hv).if { hv := -1 }
        prefix := (prefix << 1) | b
        off := (off << 1) | b
      }
      (s = 1).if { result := - prefix } else { result := prefix }
    }
    result
  )

  //
  // Match model: a hash of the pixel's causal neighbourhood (W, WW, NW, N, NE, NN, all planes)
  // points to the last pixel with the same neighbourhood; while the match keeps predicting
  // right it follows to the next pixel. Learns repeated glyphs and patterns from one occurrence.
  //

  - mtab:C_array Int := C_array Int.create 4

  - mcap:Int := 4

  - mbits:Int

  - mpos:Int

  - mlen:Int

  - mok:Boolean

  - match_reset <-
  ( + n:Int
    mbits := 12
    {(mbits < 22) && {(1 << mbits) < w * h * 2}}.while_do { mbits := mbits + 1 }
    n := 1 << mbits
    (n > mcap).if {
      mcap := n
      mtab := C_array Int.create n
    }
    0.to (n - 1) do { i:Int
      mtab.at i put 0
    }
    mpos := -1
    mlen := 0
    mok := False
  )

  - match_step np:Int at (x,y:Int) <-
  // Before coding pixel (x,y): advance or look up the match.
  ( + hh,c:Int
    ((mpos >= 0) && {mok}).if {
      mpos := mpos + 1
      (mlen < 65535).if { mlen := mlen + 1 }
    } else {
      mpos := -1
      mlen := 0
    }
    ((x >= 2) && {y >= 2} && {x < w - 1}).if {
      hh := 0
      0.to (np - 1) do { p:Int
        hh := Nova_model.hash hh with (nb p at (x - 1, y))
        hh := Nova_model.hash hh with (nb p at (x - 2, y))
        hh := Nova_model.hash hh with (nb p at (x - 1, y - 1))
        hh := Nova_model.hash hh with (nb p at (x, y - 1))
        hh := Nova_model.hash hh with (nb p at (x + 1, y - 1))
        hh := Nova_model.hash hh with (nb p at (x, y - 2))
      }
      hh := ((hh * 2146121005) & 0FFFFFFFFh) >> (32 - mbits)
      (mpos < 0).if {
        c := (mtab.at hh) - 1
        (c >= 0).if { mpos := c }
      }
      mtab.at hh put (y * w + x + 1)
    }
    mok := mpos >= 0
    Nova_model.set_match (qhalf mlen)
  )

  - expected p:Int pred pr:Int lo lo:Int step q:Int :Int <-
  // Residual the matched pixel predicts for plane p (none without a match).
  ( + ev,d,result:Int
    result := none
    (mpos >= 0).if {
      ev := sample p at (mpos % w, mpos / w)
      (q = 1).if {
        result := (ev - pr) & 255
        (result > 127).if { result := result - 256 }
      } else {
        d := (ev - pr).abs
        result := (d + eps) / q
        (ev < pr).if { result := - result }
      }
    }
    result
  )

  //
  // Level 0: palette. Regions of <= 256 colours are coded as one plane of palette indices
  // (palette sorted by luma so that MED still means something; the hashed models do the rest).
  //

  - pmode:Boolean

  - ibuf:C_array Int := C_array Int.create 4

  - icap:Int := 4

  - pal:C_array Int := C_array Int.create 256

  - pal_n:Int

  // Open-addressing colour table: key + 1 (0 = empty) and palette index.
  - hkey:C_array Int := C_array Int.create 1024

  - hidx:C_array Int := C_array Int.create 1024

  - colour_at i:Int :Int <- ((px.at i).to_int << 24) | ((px.at (i + 1)).to_int << 16) | ((px.at (i + 2)).to_int << 8) | (px.at (i + 3)).to_int

  - slot_of key:Int :Int <-
  ( + j:Int
    j := (((key * 40503) >> 10) ^ key) & 1023
    {((hkey.at j) != 0) && {(hkey.at j) != key + 1}}.while_do { j := (j + 1) & 1023 }
    j
  )

  - luma c:Int :Int <- 2 * ((c >> 24) & 255) + 5 * ((c >> 16) & 255) + ((c >> 8) & 255)

  - build_palette:Boolean <-
  // Palette of the current region if it has <= 256 colours (True).
  ( + j,c,k:Int
    + ok:Boolean
    0.to 1023 do { i:Int
      hkey.at i put 0
    }
    pal_n := 0
    ok := True
    0.to (h - 1) do { y:Int
      0.to (w - 1) do { x:Int
        (ok).if {
          c := colour_at (((oy + y) * stride + ox + x) * 4)
          j := slot_of c
          ((hkey.at j) = 0).if {
            (pal_n = 256).if {
              ok := False
            } else {
              hkey.at j put (c + 1)
              pal.at pal_n put c
              pal_n := pal_n + 1
            }
          }
        }
      }
    }
    (ok).if {
      // Insertion sort by luma, then index the table.
      1.to (pal_n - 1) do { i:Int
        c := pal.at i
        k := i - 1
        {(k >= 0) && {(luma (pal.at k)) > (luma c)}}.while_do {
          pal.at (k + 1) put (pal.at k)
          k := k - 1
        }
        pal.at (k + 1) put c
      }
      0.to (pal_n - 1) do { i:Int
        hidx.at (slot_of (pal.at i)) put i
      }
    }
    ok
  )

  - palette_fits buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) :Boolean <-
  (
    set_region buf stride s region (x0, y0, fw, fh)
    build_palette
  )

  - need_ibuf <-
  (
    (w * h > icap).if {
      icap := w * h
      ibuf := C_array Int.create icap
    }
  )

  - encode_palette np:Int <-
  // Region must fit (build_palette True). Writes count - 1, the colours, then the index plane.
  ( + c:Int
    put_byte (pal_n - 1)
    0.to (pal_n - 1) do { i:Int
      c := pal.at i
      put_byte (c >> 24)
      put_byte (c >> 16)
      put_byte (c >> 8)
      (np = 4).if { put_byte c }
    }
    need_ibuf
    0.to (h - 1) do { y:Int
      0.to (w - 1) do { x:Int
        ibuf.at (y * w + x) put (hidx.at (slot_of (colour_at (((oy + y) * stride + ox + x) * 4))))
      }
    }
    pmode := True
    level := 2
    Nova_model.start_encoder (w * h) level 2
    code_region 1
    Nova_model.flush_encoder
    pmode := False
  )

  - decode_palette data:C_array Uint8 from pos:Int size len:Int planes np:Int :Boolean <-
  ( + n,k,i,c:Int
    + result:Boolean
    n := (data.at pos).to_int + 1
    k := pos + 1 + n * np
    (k <= pos + len).if {
      0.to (n - 1) do { j:Int
        i := pos + 1 + j * np
        c := ((data.at i).to_int << 24) | ((data.at (i + 1)).to_int << 16) | ((data.at (i + 2)).to_int << 8) | 255
        (np = 4).if { c := (c & 0FFFFFF00h) | (data.at (i + 3)).to_int }
        pal.at j put c
      }
      need_ibuf
      pmode := True
      level := 2
      Nova_model.start_decoder data from k size (pos + len - k) samples (w * h) level 2
      code_region 1
      pmode := False
      0.to (h - 1) do { y:Int
        0.to (w - 1) do { x:Int
          k := ibuf.at (y * w + x)
          (k >= n).if { k := n - 1 }
          c := pal.at k
          i := ((oy + y) * stride + ox + x) * 4
          px.at i put ((c >> 24).to_uint8)
          px.at (i + 1) put (((c >> 16) & 255).to_uint8)
          px.at (i + 2) put (((c >> 8) & 255).to_uint8)
          px.at (i + 3) put ((c & 255).to_uint8)
        }
      }
      result := ! Nova_model.overrun
    }
    result
  )

  //
  // Frame coding
  //

  - code_region np:Int <-
  ( + lo,base,eg,pr,v,e,raw,i,q,er:Int
    (w * 8 > ecap).if {
      ecap := w * 8
      ebuf := C_array Int.create ecap
      pbuf := C_array Int.create (ecap * 6)
      rbuf := C_array Int.create (ecap * 2)
    }
    0.to (w * 8 - 1) do { j:Int
      ebuf.at j put 0
    }
    0.to (w * 48 - 1) do { j:Int
      pbuf.at j put 0
    }
    0.to 191 do { j:Int
      lw.at j put 0
    }
    (taps_ready).if { } else { make_taps }
    (qtables_ready).if { } else { make_qtables }
    npred := 5
    (level >= 4).if { npred := 6 }
    0.to 3 do { j:Int
      ccn.at j put 0
      ccd.at j put 0
    }
    match_reset
    0.to (h - 1) do { y:Int
      Nova_par.tick y
      0.to (w - 1) do { x:Int
        match_step np at (x, y)
        0.to (np - 1) do { p:Int
          // Once G is known, R-G+255 and B-G+255 lie in [lo, lo + 255]: code modulo 256 there.
          lo := 0
          ((p = 1) || {p = 2}).if { lo := 255 - (cur.at 0) }
          neighbours p at (x, y)
          (level < 3).if { base := predict } else { base := blend p at (x, y) }
          pr := base
          eg := 0
          ((level >= 3) && {lo != 0}).if {
            eg := err_at 0 at (x, y)
            pr := pr + (((cross p) * eg) >> 6)
          }
          (pr < lo).if { pr := lo }
          (pr > lo + 255).if { pr := lo + 255 }
          set_contexts p at (x, y) pred pr
          // Lossy (near-lossless): residual quantized by 2 eps + 1, so |error| <= eps; alpha stays exact.
          q := 1
          (p < 3).if { q := 2 * eps + 1 }
          er := expected p pred pr lo lo step q
          (Nova_model.decoding).if {
            e := code_residual 0 expect er
            (q = 1).if {
              v := lo + ((pr - lo + e + 256) & 255)
            } else {
              v := clamp (pr + e * q) in lo
            }
            store v plane p at (x, y)
          } else {
            v := sample p at (x, y)
            (q = 1).if {
              e := (v - pr) & 255
              (e > 127).if { e := e - 256 }
            } else {
              e := ((v - pr).abs + eps) / q
              (v < pr).if { e := - e }
              v := clamp (pr + e * q) in lo
              // The encoder continues from the reconstructed pixel, as the decoder will.
              store v plane p at (x, y)
            }
            code_residual e expect er
          }
          ((er = none) || {e != er}).if { mok := False }
          cur.at p put v
          rbuf.at ((((y & 3) * w) + x) * 4 + p) put v
          i := (((y & 1) * w) + x) * 4 + p
          ebuf.at i put e
          (level >= 3).if {
            0.to (npred - 1) do { k:Int
              pbuf.at (i * 6 + k) put ((v - (sp.at k)).abs)
            }
            nlms_update 0 plane p value v
            (npred = 6).if { nlms_update 1 plane p value v }
          }
          ((level >= 3) && {lo != 0}).if {
            raw := v - base
            ccn.at p put ((ccn.at p) - ((ccn.at p) >> 10) + eg * raw)
            ccd.at p put ((ccd.at p) - ((ccd.at p) >> 10) + eg * eg)
          }
        }
      }
    }
  )

  - clamp v:Int in lo:Int :Int <-
  ( + result:Int
    result := v
    (result < lo).if { result := lo }
    (result > lo + 255).if { result := lo + 255 }
    result
  )

  - set_region buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) <-
  (
    px := buf
    stride := s
    ox := x0
    oy := y0
    w := fw
    h := fh
  )

  // Each coded region starts with 2 bytes: level, eps (0 = lossless). The decoder reads all levels.
  //   0: palette of <= 256 colours (region must fit: palette_fits), always lossless
  //   1: MED, 2 direct models, 1 mixer (fast)
  //   2: + 5 hashed models, 2nd mixer, APM (graphics, text, UI)
  //   3: + blend of 5 predictors (NLMS) and cross-colour (photos)
  //   4: + wide NLMS (24 taps) as 6th predictor, 3rd mixer (slowest, largest photos)
  //   5: lossy transform coding (Nova_lossy) of RGB; the 2nd byte is the quality 0..100.
  //      With alpha: [u32 RGB length][RGB stream][alpha as a 1-plane lossless region (levels 1-4)].
  - level:Int

  - eps:Int

  - max_level:Int := 5

  - alpha_region buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) back bk:Boolean :C_array Uint8 <-
  // bk False: new fw x fh RGBA buffer whose G is the alpha of the region. True: the reverse,
  // G of alpha_buf back into the alpha of the region.
  (
    ((! bk) && {fw * fh * 4 > alpha_cap}).if {
      alpha_cap := fw * fh * 4
      alpha_buf := C_array Uint8.create alpha_cap
    }
    0.to (fh - 1) do { y:Int
      0.to (fw - 1) do { x:Int
        (bk).if {
          buf.at (((y0 + y) * s + x0 + x) * 4 + 3) put (alpha_buf.at ((y * fw + x) * 4 + 1))
        } else {
          alpha_buf.at ((y * fw + x) * 4 + 1) put (buf.at (((y0 + y) * s + x0 + x) * 4 + 3))
        }
      }
    }
    alpha_buf
  )

  - alpha_buf:C_array Uint8

  - fill_invisible buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) <-
  // Level 5 with alpha: the RGB of fully transparent pixels is never seen, so it is replaced by
  // the last visible pixel of the row (else the pixel above): flat areas cost the wavelet nothing.
  ( + i,j:Int
    0.to (fh - 1) do { y:Int
      0.to (fw - 1) do { x:Int
        i := ((y0 + y) * s + x0 + x) * 4
        ((buf.at (i + 3)).to_int = 0).if {
          j := -1
          (x > 0).if { j := i - 4 }.elseif {y > 0} then { j := i - s * 4 }
          (j >= 0).if {
            0.to 2 do { c:Int
              buf.at (i + c) put (buf.at (j + c))
            }
          }
        }
      }
    }
  )

  - alpha_cap:Int

  - encode buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) planes np:Int level lv:Int eps ep:Int <-
  // Appends the coded region to out. Lossy (ep > 0) overwrites buf with the reconstructed pixels.
  ( + at:Int
    + a:C_array Uint8
    set_region buf stride s region (x0, y0, fw, fh)
    level := lv
    eps := ep
    put_byte lv
    put_byte ep
    (lv = 0).if {
      build_palette
      eps := 0
      encode_palette np
    }.elseif {(lv = 5) && {np = 3}} then {
      Nova_lossy.encode buf stride s region (x0, y0, fw, fh) quality ep
    }.elseif {lv = 5} then {
      at := out_count
      put_u32 0
      fill_invisible buf stride s region (x0, y0, fw, fh)
      Nova_lossy.encode buf stride s region (x0, y0, fw, fh) quality ep
      set_u32 (out_count - at - 4) at at
      // Alpha goes in the G plane of a scratch region, coded alone (1 plane) and losslessly.
      a := alpha_region buf stride s region (x0, y0, fw, fh) back False
      encode a stride fw region (0, 0, fw, fh) planes 1 level 2 eps 0
    } else {
      stripes buf stride s region (x0, y0, fw, fh) planes np data NULL from 0 size 0
    }
  )

  //
  // Levels 1-4 in stripes: the region is cut into horizontal bands coded as independent regions
  // (own coder stream and models), run in parallel (Nova_par) through a shared copy of the region.
  // Layout: [stripe count] then per stripe [u32 length][coder stream].
  //

  - stripe_count (fw,fh:Int) :Int <-
  // From the region size only, never the machine: the same image always gives the same file.
  // ~2 Mpx per stripe, 16 at most.
  ( + rows,result:Int
    result := (fw * fh) / 2000000
    (result > 16).if { result := 16 }
    (result > fh).if { result := fh }
    (result < 1).if { result := 1 }
    rows := (fh + result - 1) / result
    (fh + rows - 1) / rows
  )

  - stripes buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) planes np:Int data d:C_array Uint8 from pos:Int size len:Int :Boolean <-
  // Encoder when d = NULL (appends to out), else decoder of the stripes block d[pos, pos + len).
  ( + ns,rows,r,n,at,cap,p:Int
    + ok:Boolean
    + img,sb,o:C_array Uint8
    + lens,st:C_array Int32
    + offs:C_array Int
    ok := True
    (d = NULL).if {
      ns := stripe_count (fw, fh)
    } else {
      ok := len >= 1
      (ok).if { ns := (d.at pos).to_int }
      ok := ok && {ns >= 1} && {ns <= 16} && {ns <= fh}
    }
    rows := (fh + ns - 1) / (ns.max 1)
    offs := C_array Int.create 34
    (d != NULL).if {
      p := pos + 1
      0.to (ns - 1) do { i:Int
        ok := ok && {p + 4 <= pos + len} && {i * rows < fh}
        (ok).if {
          n := (((d.at p).to_int) << 24) | (((d.at (p + 1)).to_int) << 16) | (((d.at (p + 2)).to_int) << 8) | ((d.at (p + 3)).to_int)
          ok := p + 4 + n <= pos + len
          offs.at (2 * i) put (p + 4)
          offs.at (2 * i + 1) put n
          p := p + 4 + n
        }
      }
    }
    (! ok).if {
    }.elseif {ns = 1} then {
      // One stripe: coded in place, no copy, no process.
      (d = NULL).if {
        put_byte 1
        at := out_count
        put_u32 0
        Nova_model.start_encoder (fw * fh * np) level level
        code_region np
        Nova_model.flush_encoder
        set_u32 (out_count - at - 4) at at
      } else {
        Nova_model.start_decoder d from (offs.at 0) size (offs.at 1) samples (fw * fh * np) level level
        code_region np
        ok := ! Nova_model.overrun
      }
    } else {
      img := Nova_par.shared_uint8 (fw * fh * 4)
      0.to (fh - 1) do { y:Int
        0.to (fw * 4 - 1) do { i:Int
          img.at (y * fw * 4 + i) put (buf.at (((y0 + y) * s + x0) * 4 + i))
        }
      }
      // ponytail: 8 bytes per sample is far above any real stream (a sample costs < 2 bytes).
      cap := fw * rows * np * 8 + 65536
      lens := Nova_par.shared_int32 ns
      st := Nova_par.shared_int32 ns
      sb := Nova_par.shared_uint8 (cap * ns)
      (d = NULL).if { Nova_par.progress "Encoding" of fh jobs ns } else { Nova_par.progress "Decoding" of fh jobs ns }
      0.to (ns - 1) do { i:Int
        n := Nova_par.start
        (n <= 0).if {
          r := rows.min (fh - i * rows)
          set_region img stride fw region (0, i * rows, fw, r)
          (d = NULL).if {
            at := out_count
            Nova_model.start_encoder (fw * r * np) level level
            code_region np
            Nova_model.flush_encoder
            o := out
            0.to (out_count - at - 1) do { j:Int
              sb.at (i * cap + j) put (o.at (at + j))
            }
            lens.at i put ((out_count - at).to_raw_int32)
            out_count := at
          } else {
            Nova_model.start_decoder d from (offs.at (2 * i)) size (offs.at (2 * i + 1)) samples (fw * r * np) level level
            code_region np
            (Nova_model.overrun).if { } else { st.at i put 1 }
          }
          (n = 0).if { Nova_par.finish }
        }
      }
      Nova_par.wait_all
      set_region buf stride s region (x0, y0, fw, fh)
      (d = NULL).if {
        put_byte ns
        0.to (ns - 1) do { i:Int
          n := (lens.at i).to_int
          put_u32 n
          0.to (n - 1) do { j:Int
            put_byte ((sb.at (i * cap + j)).to_int)
          }
        }
      } else {
        0.to (ns - 1) do { i:Int
          ok := ok && {(st.at i).to_int = 1}
        }
      }
      // Decoded pixels, or the reconstruction of near-lossless, back into buf.
      ((d != NULL) || {eps > 0}).if {
        0.to (fh - 1) do { y:Int
          0.to (fw * 4 - 1) do { i:Int
            buf.at (((y0 + y) * s + x0) * 4 + i) put (img.at (y * fw * 4 + i))
          }
        }
      }
      Nova_par.free_u8 sb size (cap * ns)
      Nova_par.free lens size (ns * 4)
      Nova_par.free st size (ns * 4)
      Nova_par.free_u8 img size (fw * fh * 4)
    }
    ok
  )

  - scratch:C_array Uint8 := C_array Uint8.create 4

  - scratch_cap:Int := 4

  - trial buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) planes np:Int level lv:Int eps ep:Int :Int <-
  // Coded size of the region at this level, on a scratch copy (buf and out are left untouched).
  ( + start,result:Int
    (fw * fh * 4 > scratch_cap).if {
      scratch_cap := fw * fh * 4
      scratch := C_array Uint8.create scratch_cap
    }
    0.to (fh - 1) do { y:Int
      0.to (fw * 4 - 1) do { i:Int
        scratch.at (y * fw * 4 + i) put (buf.at (((y0 + y) * s + x0) * 4 + i))
      }
    }
    start := out_count
    encode scratch stride fw region (0, 0, fw, fh) planes np level lv eps ep
    result := out_count - start
    out_count := start
    result
  )

  // A decoded region was lossy (level 5, or eps > 0); reset by the caller.
  - lossy_seen:Boolean

  - decode data:C_array Uint8 from pos:Int size len:Int into buf:C_array Uint8 stride s:Int region (x0,y0,fw,fh:Int) planes np:Int :Boolean <-
  // Decodes one coded region into buf. False if the block is corrupt or of an unknown level.
  ( + result:Boolean
    + n:Int
    + a:C_array Uint8
    set_region buf stride s region (x0, y0, fw, fh)
    ((len >= 3) && {(data.at pos).to_int = 0}).if {
      eps := 0
      result := decode_palette data from (pos + 2) size (len - 2) planes np
    }.elseif {(len >= 2) && {(data.at pos).to_int = 5} && {(data.at (pos + 1)).to_int <= 100} && {np = 3}} then {
      lossy_seen := True
      result := Nova_lossy.decode data from (pos + 2) size (len - 2) into buf stride s region (x0, y0, fw, fh) quality ((data.at (pos + 1)).to_int)
    }.elseif {(len >= 6) && {(data.at pos).to_int = 5} && {(data.at (pos + 1)).to_int <= 100} && {np = 4}} then {
      lossy_seen := True
      n := (((data.at (pos + 2)).to_int) << 24) | (((data.at (pos + 3)).to_int) << 16) | (((data.at (pos + 4)).to_int) << 8) | ((data.at (pos + 5)).to_int)
      result := (n <= len - 8) && {(data.at (pos + 6 + n)).to_int >= 1} && {(data.at (pos + 6 + n)).to_int <= 4}
      result := result && {Nova_lossy.decode data from (pos + 6) size n into buf stride s region (x0, y0, fw, fh) quality ((data.at (pos + 1)).to_int)}
      (result).if {
        a := alpha_region buf stride s region (x0, y0, fw, fh) back False
        result := decode data from (pos + 6 + n) size (len - 6 - n) into a stride fw region (0, 0, fw, fh) planes 1
        alpha_region buf stride s region (x0, y0, fw, fh) back True
      }
    }.elseif {(len >= 2) && {(data.at pos).to_int >= 1} && {(data.at pos).to_int <= 4} && {(data.at (pos + 1)).to_int <= 64}} then {
      level := (data.at pos).to_int
      eps := (data.at (pos + 1)).to_int
      (eps > 0).if { lossy_seen := True }
      result := stripes buf stride s region (x0, y0, fw, fh) planes np data data from (pos + 2) size (len - 2)
    }
    result
  )
