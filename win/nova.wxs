<?xml version="1.0" encoding="utf-8"?>
<!-- NOVA for Windows, MSI (wixl from msitools, built by win/dist.sh from dist/nova-windows/).
     Same install as win/nova.nsi, but the WIC codec keys are written here (the ones DllRegisterServer
     writes in plugins/wic/nova_wic.cpp: keep both in step), so Windows Installer removes them itself.
     Refresh (a nova_wic.dll export) tells Explorer the file types changed, after install and before the
     codec is removed on uninstall. -->
<Wix xmlns="http://schemas.microsoft.com/wix/2006/wi">
  <Product Id="*" Name="NOVA image format" Version="2.0.0" Manufacturer="Thibault SAVENKOFF" Language="1033"
           UpgradeCode="6C1D4E0B-8F7A-4C55-9B7E-2A1F3D5C7E90">
    <Package InstallerVersion="500" Compressed="yes" InstallScope="perMachine"
             Description="NOVA: nova.exe and the Windows Imaging Component codec"/>
    <Media Id="1" Cabinet="nova.cab" EmbedCab="yes"/>
    <Icon Id="nova.ico" SourceFile="win/nova.ico"/>
    <Property Id="ARPPRODUCTICON" Value="nova.ico"/>

    <Directory Id="TARGETDIR" Name="SourceDir">
      <Directory Id="ProgramFiles64Folder">
        <Directory Id="INSTALLDIR" Name="NOVA">
          <Component Id="Program" Guid="3A2B7C41-5D6E-4F80-9123-4B5C6D7E8F01" Win64="yes">
            <File Id="nova.exe" Source="dist/nova-windows/nova.exe" KeyPath="yes"/>
            <File Id="zlib1.dll" Source="dist/nova-windows/zlib1.dll"/>
            <File Id="libwebp.dll" Source="dist/nova-windows/libwebp-7.dll"/>
            <File Id="libsharpyuv.dll" Source="dist/nova-windows/libsharpyuv-0.dll"/>
            <!-- Camera RAW. The soname is pinned the same way nova_rawin.li pins .so.25:
                 a LibRaw major bump needs a code change anyway, and wixl fails loudly here. -->
            <File Id="libraw.dll" Source="dist/nova-windows/libraw_r-25.dll"/>
            <File Id="libgcc.dll" Source="dist/nova-windows/libgcc_s_seh-1.dll"/>
            <File Id="liblcms2.dll" Source="dist/nova-windows/liblcms2-2.dll"/>
            <File Id="libstdcxx.dll" Source="dist/nova-windows/libstdc++-6.dll"/>
            <File Id="libwinpthread.dll" Source="dist/nova-windows/libwinpthread-1.dll"/>
            <!-- HEIC reading, cross-compiled by win/deps.sh (no mingw64 package exists). -->
            <File Id="libheif.dll" Source="dist/nova-windows/libheif.dll"/>
            <File Id="libde265.dll" Source="dist/nova-windows/libde265.dll"/>
            <!-- AVIF: aom both ways, libavif for the HDR gain map. win/dist.sh fails the build if
                 a DLL it packages is missing from this list, since wixl itself would not. -->
            <File Id="libaom.dll" Source="dist/nova-windows/libaom.dll"/>
            <File Id="libavif.dll" Source="dist/nova-windows/libavif.dll"/>
            <File Id="nova.completion.ps1" Source="dist/nova-windows/nova-completion.ps1"/>
            <File Id="nova.profile.ps1" Source="dist/nova-windows/nova-profile.ps1"/>
            <File Id="readme.txt" Source="dist/nova-windows/README.txt"/>
            <!-- Tab completion needs a line in the user's PowerShell profile. RunCompletion below
                 writes the installing user's right away; this covers every *other* user of a
                 per-machine install: Active Setup runs the command once per user, in their own
                 session, at their next logon. Same GUID as win/nova.nsi so the two installers do
                 not both register it. Uninstalling removes the key; a line already added to a
                 profile goes away with `nova-profile.ps1 -Remove`, and loads nothing once the
                 file is gone. -->
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Active Setup\Installed Components\{B7E2A93C-5F14-4A88-9C3D-61D0A7F2E845}">
              <RegistryValue Type="string" Value="NOVA tab completion"/>
              <RegistryValue Name="Version" Type="string" Value="1"/>
              <RegistryValue Name="StubPath" Type="expandable" Value='"%SystemRoot%\System32\WindowsPowerShell\v1.0\powershell.exe" -NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "[INSTALLDIR]nova-profile.ps1" -Script "[INSTALLDIR]nova-completion.ps1"'/>
            </RegistryKey>
            <File Id="lic.nova" Source="dist/nova-windows/LICENSE-nova.txt"/>
            <File Id="lic.zlib" Source="dist/nova-windows/LICENSE-zlib.txt"/>
            <File Id="lic.webp" Source="dist/nova-windows/LICENSE-libwebp.txt"/>
            <File Id="lic.libraw" Source="dist/nova-windows/LICENSE-libraw.txt"/>
            <File Id="lic.libheif" Source="dist/nova-windows/LICENSE-libheif.txt"/>
            <File Id="lic.libde265" Source="dist/nova-windows/LICENSE-libde265.txt"/>
            <File Id="lic.libaom" Source="dist/nova-windows/LICENSE-libaom.txt"/>
            <File Id="lic.libavif" Source="dist/nova-windows/LICENSE-libavif.txt"/>
            <Environment Id="Path" Name="PATH" Value="[INSTALLDIR]" Action="set" Part="last" System="yes" Permanent="no"/>
          </Component>
          <Component Id="Codec" Guid="7E8F9A0B-1C2D-4E3F-8A4B-5C6D7E8F9A12" Win64="yes">
            <File Id="nova_wic.dll" Source="dist/nova-windows/nova_wic.dll" KeyPath="yes"/>
            <RegistryKey Root="HKCR" Key="CLSID\{40E4326E-629B-488E-8D94-3959498E1ACD}">
              <RegistryValue Type="string" Value="NOVA Decoder"/>
              <RegistryValue Name="FriendlyName" Type="string" Value="NOVA Decoder"/>
              <RegistryValue Name="Author" Type="string" Value="NOVA"/>
              <RegistryValue Name="Vendor" Type="string" Value="{B4AFAA41-52C1-41D0-9FD4-C77EFE7BFE19}"/>
              <RegistryValue Name="Version" Type="string" Value="2.0.0"/>
              <RegistryValue Name="ContainerFormat" Type="string" Value="{B4AFAA41-52C1-41D0-9FD4-C77EFE7BFE19}"/>
              <RegistryValue Name="FileExtensions" Type="string" Value=".nova"/>
              <RegistryValue Name="MimeTypes" Type="string" Value="image/x-nova"/>
              <RegistryValue Name="SupportsAnimation" Type="integer" Value="1"/>
              <RegistryValue Name="SupportsMultiframe" Type="integer" Value="1"/>
              <RegistryValue Name="SupportsLossless" Type="integer" Value="1"/>
              <RegistryValue Name="SupportsChromakey" Type="integer" Value="0"/>
              <RegistryValue Name="ArbitrationPriority" Type="integer" Value="10"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="CLSID\{40E4326E-629B-488E-8D94-3959498E1ACD}\InprocServer32">
              <RegistryValue Type="string" Value="[#nova_wic.dll]"/>
              <RegistryValue Name="ThreadingModel" Type="string" Value="Both"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="CLSID\{40E4326E-629B-488E-8D94-3959498E1ACD}\Formats\{6FDDC324-4E03-4BFE-B185-3D77768DC90F}">
              <RegistryValue Type="string" Value=""/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="CLSID\{40E4326E-629B-488E-8D94-3959498E1ACD}\Patterns\0">
              <RegistryValue Name="Position" Type="integer" Value="0"/>
              <RegistryValue Name="Length" Type="integer" Value="9"/>
              <RegistryValue Name="Pattern" Type="binary" Value="894E4F56410D0A1A0A"/>
              <RegistryValue Name="Mask" Type="binary" Value="FFFFFFFFFFFFFFFFFF"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="CLSID\{7ED96837-96F0-4812-B211-F13C24117ED3}\Instance\{40E4326E-629B-488E-8D94-3959498E1ACD}">
              <RegistryValue Name="CLSID" Type="string" Value="{40E4326E-629B-488E-8D94-3959498E1ACD}"/>
              <RegistryValue Name="FriendlyName" Type="string" Value="NOVA Decoder"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key=".nova">
              <RegistryValue Type="string" Value="NOVA.Image"/>
              <RegistryValue Name="Content Type" Type="string" Value="image/x-nova"/>
              <RegistryValue Name="PerceivedType" Type="string" Value="image"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key=".nova\OpenWithProgids">
              <RegistryValue Name="NOVA.Image" Type="string" Value=""/>
            </RegistryKey>
            <!-- double-click: Windows Photo Viewer, which decodes through this codec (Photos opens .nova blank) -->
            <RegistryKey Root="HKCR" Key="NOVA.Image">
              <RegistryValue Type="string" Value="NOVA image"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="NOVA.Image\DefaultIcon">
              <RegistryValue Type="string" Value="[#nova_wic.dll],0"/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key="NOVA.Image\shell\open\command">
              <RegistryValue Type="expandable" Value='%SystemRoot%\System32\rundll32.exe "%ProgramFiles%\Windows Photo Viewer\PhotoViewer.dll", ImageView_Fullscreen %1'/>
            </RegistryKey>
            <RegistryKey Root="HKCR" Key=".nova\ShellEx\{E357FCCD-A995-4576-B01F-234630154E96}">
              <RegistryValue Type="string" Value="{C7657C4A-9F68-40FA-A4DF-96BC08EB3551}"/>
            </RegistryKey>
            <RegistryKey Root="HKLM" Key="SOFTWARE\Microsoft\Windows\CurrentVersion\Explorer\KindMap">
              <RegistryValue Name=".nova" Type="string" Value="picture"/>
            </RegistryKey>
          </Component>
          <Directory Id="SAMPLES" Name="samples">
            <Component Id="Samples" Guid="9B0C1D2E-3F4A-4B5C-8D6E-7F8091A2B3C4" Win64="yes">
              <File Id="photo.nova" Source="dist/nova-windows/photo.nova" KeyPath="yes"/>
              <File Id="screenshot.nova" Source="dist/nova-windows/screenshot.nova"/>
              <File Id="animation.nova" Source="dist/nova-windows/animation.nova"/>
            </Component>
          </Directory>
        </Directory>
      </Directory>
    </Directory>

    <!-- a copy of the codec DLL inside the MSI: Windows Installer calls Refresh from it -->
    <Binary Id="NovaWic" SourceFile="dist/nova-windows/nova_wic.dll"/>
    <CustomAction Id="RefreshInstall" BinaryKey="NovaWic" DllEntry="Refresh" Return="ignore"/>
    <!-- Active Setup only reaches a user at their next logon. This runs the same script right away
         for whoever is installing, which on a personal machine (UAC elevates the same account) is
         the user who will actually type `nova`. Immediate, and after InstallFinalize: a deferred
         action resolves no property (so no [INSTALLDIR]), and anything sequenced earlier runs
         before the files are on disk. The script is idempotent, so the two paths cannot double
         the line. -->
    <Property Id="PSEXE" Value="powershell.exe"/>
    <CustomAction Id="RunCompletion" Property="PSEXE" Execute="immediate" Return="ignore"
                  ExeCommand='-NoProfile -WindowStyle Hidden -ExecutionPolicy Bypass -File "[INSTALLDIR]nova-profile.ps1" -Script "[INSTALLDIR]nova-completion.ps1"'/>
    <!-- Immediate, not deferred: wixl ignores After= and numbers these in document order, so this
         lands after InstallFinalize whatever it claims to follow, and a deferred action outside
         the install transaction is error 2762 ("cannot write script record"). That is the dialog
         an uninstall showed. Immediate is right here anyway: by then the keys are already gone,
         which is what the shell is being told about. -->
    <CustomAction Id="RefreshRemove" BinaryKey="NovaWic" DllEntry="Refresh" Return="ignore"/>
    <InstallExecuteSequence>
      <Custom Action="RefreshInstall" After="InstallFinalize">NOT REMOVE</Custom>
      <Custom Action="RunCompletion" After="RefreshInstall">NOT REMOVE</Custom>
      <Custom Action="RefreshRemove" After="RunCompletion">REMOVE="ALL"</Custom>
    </InstallExecuteSequence>

    <Feature Id="All" Level="1">
      <ComponentRef Id="Program"/>
      <ComponentRef Id="Codec"/>
      <ComponentRef Id="Samples"/>
    </Feature>
  </Product>
</Wix>
