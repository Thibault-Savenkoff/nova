// Icon and version information of nova.exe and nova_wic.dll (-DNOVA_DLL). nova_version.h is written
// from nova.li by win/build.sh and plugins/wic/build.sh: NOVA_V "2.0.0-beta.5", NOVA_V4 2,0,0,5.
#include <winver.h>
#include "nova_version.h"
#ifdef NOVA_DLL
#define NOVA_DESC "NOVA image codec for Windows (Explorer thumbnails and previews)"
#define NOVA_FILE "nova_wic.dll"
#define NOVA_FT VFT_DLL
#else
#define NOVA_DESC "NOVA image codec (command line)"
#define NOVA_FILE "nova.exe"
#define NOVA_FT VFT_APP
#endif

1 ICON "nova.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION NOVA_V4
PRODUCTVERSION NOVA_V4
FILEFLAGSMASK 0x3f
FILEFLAGS 0
FILEOS VOS_NT_WINDOWS32
FILETYPE NOVA_FT
FILESUBTYPE 0
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "FileDescription", NOVA_DESC
      VALUE "FileVersion", NOVA_V
      VALUE "InternalName", NOVA_FILE
      VALUE "OriginalFilename", NOVA_FILE
      VALUE "ProductName", "NOVA"
      VALUE "ProductVersion", NOVA_V
      VALUE "LegalCopyright", "MIT License, github.com/Thibault-Savenkoff/nova"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
