Header
  + name := Nova_tiff
  // TIFF writer: DNG output of a RAW .nova (sensor frame, RAWH parameters) and TIFF output of an
  // image (8 or 16 bits, zlib strips). One IFD; tag data after it, then the pixels.
  // EXIF blocks (TIFF streams) are copied with their offsets moved: their IFD 0 tags are merged
  // into ours, their Exif and GPS IFDs pointed to. The file takes the byte order of the EXIF block
  // (iPhones write big-endian), so maker notes stay valid.
  // ponytail: DNG: Canon maker notes (CMT3) stay in the .nova only; add DNGPrivateData if a raw
  // developer needs them.

Public

  - src:C_array Uint8

  // File byte order: big-endian ("MM") or little-endian ("II"); src blocks are read the same way.
  - big:Boolean

  - u8 p:Int :Int <- (src.at p).to_int

  - u32 p:Int :Int <- ((u8 p) << 24) | ((u8 (p + 1)) << 16) | ((u8 (p + 2)) << 8) | (u8 (p + 3))

  - r16 p:Int :Int <-
  ( + result:Int
    (big).if { result := ((u8 p) << 8) | (u8 (p + 1)) } else { result := (u8 p) | ((u8 (p + 1)) << 8) }
    result
  )

  - r32 p:Int :Int <-
  ( + result:Int
    (big).if { result := ((r16 p) << 16) | (r16 (p + 2)) } else { result := (r16 p) | ((r16 (p + 2)) << 16) }
    result
  )

  // Raw 4 bytes at src[p], packed b0 | b1 << 8 | ... (written back in the same order).
  - raw4 p:Int :Int <- (u8 p) | ((u8 (p + 1)) << 8) | ((u8 (p + 2)) << 16) | ((u8 (p + 3)) << 24)

  // Tag data too large for an entry, placed after the IFD.
  - ext:C_array Uint8 := C_array Uint8.create 4

  - ext_n:Int

  - e8 v:Int <-
  (
    ext.at ext_n put ((v & 255).to_uint8)
    ext_n := ext_n + 1
  )

  - e16 v:Int <-
  (
    (big).if {
      e8 (v >> 8)
      e8 v
    } else {
      e8 v
      e8 (v >> 8)
    }
  )

  - e32 v:Int <-
  (
    (big).if {
      e16 (v >> 16)
      e16 v
    } else {
      e16 v
      e16 (v >> 16)
    }
  )

  - xb p:Int :Int <- (ext.at p).to_int

  - x16 p:Int :Int <-
  ( + result:Int
    (big).if { result := ((xb p) << 8) | (xb (p + 1)) } else { result := (xb p) | ((xb (p + 1)) << 8) }
    result
  )

  - x32 p:Int :Int <-
  ( + result:Int
    (big).if { result := ((x16 p) << 16) | (x16 (p + 2)) } else { result := (x16 p) | ((x16 (p + 2)) << 16) }
    result
  )

  - set32 v:Int at p:Int <-
  (
    0.to 3 do { i:Int
      (big).if {
        ext.at (p + i) put (((v >> (24 - 8 * i)) & 255).to_uint8)
      } else {
        ext.at (p + i) put (((v >> (8 * i)) & 255).to_uint8)
      }
    }
  )

  // IFD entries, 5 ints each: tag, type, count, value, kind: 0 number (written by type), 1 ext
  // offset, 2 pixel offset, 3 ext offset of LONG offsets relative to the pixels, 4 raw 4 bytes.
  - ent:Array Int := Array Int.create_with_capacity 256

  - has t:Int :Boolean <-
  ( + result:Boolean
    0.to (ent.count / 5 - 1) do { i:Int
      ((ent.at (i * 5)) = t).if { result := True }
    }
    result
  )

  - add t:Int type ty:Int count c:Int value v:Int kind k:Int <-
  (
    ent.add_last t
    ent.add_last ty
    ent.add_last c
    ent.add_last v
    ent.add_last k
  )

  - tsize ty:Int :Int <-
  ( + result:Int
    result := 4
    ((ty = 1) || {ty = 2} || {ty = 6} || {ty = 7}).if { result := 1 }
    ((ty = 3) || {ty = 8}).if { result := 2 }
    ((ty = 5) || {ty = 10} || {ty = 12}).if { result := 8 }
    result
  )

  - add_data t:Int type ty:Int count c:Int from pos:Int <-
  // Data written at ext[pos, ext_n): moved into the entry when it fits in 4 bytes.
  ( + v:Int
    (c * (tsize ty) <= 4).if {
      ext_n.to (pos + 3) do { i:Int ext.at i put 0 }
      v := (xb pos) | ((xb (pos + 1)) << 8) | ((xb (pos + 2)) << 16) | ((xb (pos + 3)) << 24)
      ext_n := pos
      add t type ty count c value v kind 4
    } else {
      (ext_n & 1 = 1).if { e8 0 }
      add t type ty count c value pos kind 1
    }
  )

  - add_bytes t:Int type ty:Int from p:Int size n:Int <-
  // Tag of n bytes (ASCII, BYTE or UNDEFINED) from src[p, p + n).
  ( + pos:Int
    pos := ext_n
    p.to (p + n - 1) do { i:Int e8 (u8 i) }
    add_data t type ty count n from pos
  )

  - add_string t:Int from p:Int size n:Int <-
  // ASCII tag from src[p, p + n), NUL added.
  ( + pos:Int
    pos := ext_n
    p.to (p + n - 1) do { i:Int e8 (u8 i) }
    e8 0
    add_data t type 2 count (n + 1) from pos
  )

  //
  // EXIF blocks (TIFF streams): IFD entries copied, offsets moved by delta.
  //

  - move_ifd o:Int in (q,len:Int) by delta:Int depth dp:Int <-
  // IFD at q + o in ext (block at q of len bytes): data offsets and sub-IFD pointers + delta.
  ( + n,e,t,v:Int
    ((o >= 8) && {o + 2 <= len} && {dp < 4}).if {
      n := x16 (q + o)
      ((o + 2 + n * 12 + 4) <= len).if {
        0.to (n - 1) do { i:Int
          e := q + o + 2 + i * 12
          t := x16 e
          v := x32 (e + 8)
          ((t = 34665) || {t = 34853} || {t = 40965}).if {
            move_ifd v in (q, len) by delta depth (dp + 1)
            set32 (v + delta) at (e + 8)
          }.elseif {(x32 (e + 4)) * (tsize (x16 (e + 2))) > 4} then {
            set32 (v + delta) at (e + 8)
          }
        }
        e := q + o + 2 + n * 12
        ((x32 e) != 0).if { set32 ((x32 e) + delta) at e }
      }
    }
  )

  // Blocks copied to ext: position, length, IFD offset (3 ints each), moved once the layout is known.
  - blocks:Array Int := Array Int.create_with_capacity 6

  - copy_block (p,n:Int) :Int <-
  // src[p, p + n) (a TIFF stream in the file's byte order) -> ext; returns its ext position.
  ( + result:Int
    (ext_n & 1 = 1).if { e8 0 }
    result := ext_n
    p.to (p + n - 1) do { i:Int e8 (u8 i) }
    blocks.add_last result
    blocks.add_last n
    blocks.add_last (r32 (p + 4))
    result
  )

  - same_order p:Int :Boolean <- ((u8 p) = 4Dh) = big

  - merge_ifd0 (p,n:Int) <-
  // Entries of the IFD 0 of src[p, p + n) that ours does not have (pointers and thumbnails skipped).
  ( + o,c,e,t,ty,cn,sz,v,pos:Int
    o := r32 (p + 4)
    ((o >= 8) && {o + 2 <= n}).if {
      c := r16 (p + o)
      0.to (c - 1) do { i:Int
        e := p + o + 2 + i * 12
        ((o + 2 + i * 12 + 12) <= n).if {
          t := r16 e
          ty := r16 (e + 2)
          cn := r32 (e + 4)
          v := r32 (e + 8)
          sz := cn * (tsize ty)
          ((! (has t)) && {! (structure t)} && {sz < 65536}).if {
            (sz <= 4).if {
              add t type ty count cn value (raw4 (e + 8)) kind 4
            }.elseif {(v >= 0) && {v + sz <= n}} then {
              pos := ext_n
              (p + v).to (p + v + sz - 1) do { j:Int e8 (u8 j) }
              add_data t type ty count cn from pos
            }
          }
        }
      }
    }
  )

  - structure t:Int :Boolean <-
  // Tags describing the source's own pixels (size, strips, tiles, thumbnail) or pointers.
  (t < 270) || {t = 273} || {(t >= 277) && {t <= 279}} || {t = 284} || {(t >= 322) && {t <= 325}} || {t = 330} || {t = 513} || {t = 514} || {t = 34665} || {t = 34853}

  - add_exif (p,n:Int) <-
  // EXIF TIFF stream src[p, p + n) (same byte order as the file): IFD 0 tags merged, Exif and GPS
  // IFDs copied and pointed to.
  ( + o,c,e,t,pos:Int
    ((n > 8) && {same_order p}).if {
      pos := copy_block (p, n)
      merge_ifd0 (p, n)
      o := r32 (p + 4)
      ((o >= 8) && {o + 2 <= n}).if {
        c := r16 (p + o)
        0.to (c - 1) do { i:Int
          e := p + o + 2 + i * 12
          t := r16 e
          ((((t = 34665) || {t = 34853})) && {o + 2 + i * 12 + 12 <= n} && {! (has t)}).if {
            add t type 4 count 1 value (pos + (r32 (e + 8))) kind 1
          }
        }
      }
    }
  )

  //
  // File
  //

  - start cap:Int <-
  (
    ent.clear
    blocks.clear
    ext := C_array Uint8.create cap
    ext_n := 0
  )

  - o16 v:Int <-
  (
    (big).if {
      Nova_codec.put_byte (v >> 8)
      Nova_codec.put_byte v
    } else {
      Nova_codec.put_byte v
      Nova_codec.put_byte (v >> 8)
    }
  )

  - o32 v:Int <-
  (
    (big).if {
      o16 (v >> 16)
      o16 v
    } else {
      o16 v
      o16 (v >> 16)
    }
  )

  - finish name:String pixels mode:Int size (w,h:Int) <-
  // Writes the file: header, sorted IFD, tag data, pixels (mode 0: Nova_raw samples as 16 bits,
  // 1: the strips of Nova_zlib.tiff, 2: none). name = NULL: left in Nova_codec.out.
  ( + n,k,t,base,pix,ty,v,pos:Int
    + d:C_array Uint8
    n := ent.count / 5
    1.to (n - 1) do { i:Int
      k := i
      {(k > 0) && {(ent.at ((k - 1) * 5)) > (ent.at (k * 5))}}.while_do {
        0.to 4 do { j:Int
          t := ent.at ((k - 1) * 5 + j)
          ent.at ((k - 1) * 5 + j) put (ent.at (k * 5 + j))
          ent.at (k * 5 + j) put t
        }
        k := k - 1
      }
    }
    base := 8 + 2 + n * 12 + 4
    (ext_n & 1 = 1).if { e8 0 }
    pix := base + ext_n
    0.to (n - 1) do { i:Int
      ((ent.at (i * 5 + 4)) = 3).if {
        pos := ent.at (i * 5 + 3)
        0.to (ent.at (i * 5 + 2) - 1) do { j:Int
          set32 ((x32 (pos + 4 * j)) + pix) at (pos + 4 * j)
        }
      }
    }
    0.to (blocks.count / 3 - 1) do { i:Int
      move_ifd (blocks.at (i * 3 + 2)) in (blocks.at (i * 3), blocks.at (i * 3 + 1)) by (base + (blocks.at (i * 3))) depth 0
    }
    Nova_codec.reset_out
    (big).if {
      Nova_codec.put_byte 4Dh
      Nova_codec.put_byte 4Dh
    } else {
      Nova_codec.put_byte 49h
      Nova_codec.put_byte 49h
    }
    o16 42
    o32 8
    o16 n
    0.to (n - 1) do { i:Int
      o16 (ent.at (i * 5))
      ty := ent.at (i * 5 + 1)
      o16 ty
      o32 (ent.at (i * 5 + 2))
      k := ent.at (i * 5 + 4)
      v := ent.at (i * 5 + 3)
      (k = 0).if {
        ((ty = 3) || {ty = 8}).if {
          o16 (v & 0FFFFh)
          o16 (v >> 16)
        }.elseif {(ty = 1) || {ty = 2} || {ty = 6} || {ty = 7}} then {
          0.to 3 do { j:Int
            Nova_codec.put_byte (v >> (8 * j))
          }
        } else {
          o32 v
        }
      }.elseif {k = 4} then {
        0.to 3 do { j:Int
          Nova_codec.put_byte (v >> (8 * j))
        }
      }.elseif {(k = 1) || {k = 3}} then {
        o32 (base + v)
      } else {
        o32 pix
      }
    }
    o32 0
    0.to (ext_n - 1) do { i:Int
      Nova_codec.put_byte ((ext.at i).to_int)
    }
    (mode = 0).if {
      0.to (w * h - 1) do { i:Int o16 (Nova_raw.value i) }
    }.elseif {mode = 1} then {
      d := Nova_zlib.data
      0.to (Nova_zlib.size - 1) do { i:Int
        Nova_codec.put_byte ((d.at i).to_int)
      }
    }
    (name != NULL).if { Nova.save_out name }
  )

  //
  // EXIF of a RAW
  //

  - add_cmt (mp,ml:Array Int) <-
  // CR3 CMT blocks: CMT2 is the Exif IFD itself (as the IFD 0 of its stream), CMT4 the GPS IFD,
  // CMT1 IFD 0 tags merged.
  ( + p,n,pos:Int
    0.to (mp.upper) do { i:Int
      p := mp.at i
      n := ml.at i - 4
      (((u32 p) = 434D5432h) && {n > 8} && {same_order (p + 4)}).if {
        pos := copy_block (p + 4, n)
        add 34665 type 4 count 1 value (pos + (r32 (p + 8))) kind 1
      }
      (((u32 p) = 434D5434h) && {n > 8} && {same_order (p + 4)}).if {
        pos := copy_block (p + 4, n)
        add 34853 type 4 count 1 value (pos + (r32 (p + 8))) kind 1
      }
    }
  )

  - merge_cmt1 (mp,ml:Array Int) <-
  ( + p:Int
    0.to (mp.upper) do { i:Int
      p := mp.at i
      (((u32 p) = 434D5431h) && {ml.at i > 12} && {same_order (p + 4)}).if { merge_ifd0 (p + 4, ml.at i - 4) }
    }
  )

  - exif_of d:C_array Uint8 metas (mp,ml:Array Int) <-
  // EXIF TIFF stream (no pixels) of a RAW .nova in Nova_codec.out, for developed images: the
  // pixels are already rotated, so Orientation is 1.
  ( + cap:Int
    src := d
    big := False
    cap := 65536
    0.to (ml.upper) do { i:Int cap := cap + ml.at i }
    start cap
    add 274 type 3 count 1 value 1 kind 0
    add_cmt (mp, ml)
    merge_cmt1 (mp, ml)
    finish NULL pixels 2 size (0, 0)
  )

  //
  // TIFF image
  //

  // True: the 16-bit samples of the next write_image are IEEE half floats (SampleFormat 3).
  - float_samples:Boolean

  - set_float f:Boolean <- ( float_samples := f; )

  - write_image name:String pixels buf:C_array Uint8 bits b:Int planes np:Int size (w,h:Int) data d:C_array Uint8 exif (ep,en:Int) icc (ic:C_array Uint8, icn:Int) xmp (xp,xn:Int) <-
  // buf: RGBA bytes (bits 8, np = 3 or 4 of them kept) or np unsigned shorts per pixel (bits 16).
  // exif: TIFF stream at d[ep, ep + en) (en = 0: none), xmp: d[xp, xp + xn), icc: ic[0, icn).
  ( + ns,pos:Int
    + px:Pointer
    px := `(void *)@buf`:Pointer
    src := d
    big := (en > 8) && {(u8 ep) = 4Dh}
    Nova_zlib.set_predictor (! float_samples)
    ns := Nova_zlib.tiff px bits b size (w, h) planes np big big
    Nova_zlib.set_predictor True
    (ns = 0).if { Nova.fail "TIFF compression failed" }
    start (65536 + en + xn + icn)
    add 254 type 4 count 1 value 0 kind 0
    add 256 type 4 count 1 value w kind 0
    add 257 type 4 count 1 value h kind 0
    pos := ext_n
    np.times { e16 b }
    add_data 258 type 3 count np from pos
    add 259 type 3 count 1 value (Nova_zlib.compression) kind 0
    add 262 type 3 count 1 value 2 kind 0
    pos := ext_n
    0.to (ns - 1) do { i:Int e32 (Nova_zlib.strip_offset i) }
    (ns = 1).if {
      ext_n := pos
      add 273 type 4 count 1 value 0 kind 2
    } else {
      add 273 type 4 count ns value pos kind 3
    }
    add 277 type 3 count 1 value np kind 0
    add 278 type 4 count 1 value (Nova_zlib.rows_per_strip) kind 0
    pos := ext_n
    0.to (ns - 1) do { i:Int e32 (Nova_zlib.strip_length i) }
    add_data 279 type 4 count ns from pos
    add 284 type 3 count 1 value 1 kind 0
    (((Nova_zlib.compression) = 8) && {! float_samples}).if { add 317 type 3 count 1 value 2 kind 0 }
    // Alpha: unassociated (PNG-like, not premultiplied).
    (np = 4).if { add 338 type 3 count 1 value 2 kind 0 }
    (float_samples).if {
      pos := ext_n
      np.times { e16 3 }
      add_data 339 type 3 count np from pos
    }
    (xn > 0).if { add_bytes 700 type 1 from xp size xn }
    (icn > 0).if {
      pos := ext_n
      0.to (icn - 1) do { i:Int e8 ((ic.at i).to_int) }
      add_data 34675 type 7 count icn from pos
    }
    (en > 8).if { add_exif (ep, en) }
    finish name pixels 1 size (w, h)
  )

  //
  // DNG
  //

  - write_dng name:String data d:C_array Uint8 rawh rh:Int metas (mp,ml:Array Int) size (w,h:Int) <-
  ( + nb,fo,o,flt,filters,top,left,vw,vh,bl,c4,c5,pos,cap,k,cl:Int
    + cfa:C_array Int
    src := d
    big := False
    cap := 65536
    0.to (ml.upper) do { i:Int cap := cap + ml.at i }
    start cap
    top := u32 (rh + 1)
    left := u32 (rh + 5)
    vw := u32 (rh + 9)
    vh := u32 (rh + 13)
    filters := u32 (rh + 17)
    nb := u32 (rh + 37)
    c4 := 0
    c5 := 0
    (nb >= 6).if {
      c4 := u32 (rh + 41 + 16)
      c5 := u32 (rh + 41 + 20)
    }
    flt := rh + 41 + 4 * nb
    // CFA colour (0 R, 1 G, 2 B) at (r, c) of the active area: LibRaw's filters and cdesc.
    cfa := C_array Int.create 4
    0.to 3 do { i:Int
      k := (filters >> (((((i >> 1) << 1) & 14) | (i & 1)) << 1)) & 3
      cl := u8 (rh + 21 + k)
      (cl = 'R'.to_int).if { cfa.at i put 0 }.elseif {cl = 'B'.to_int} then { cfa.at i put 2 } else { cfa.at i put 1 }
      cfa.at i put ((cfa.at i) | (k << 8))
    }
    add 254 type 4 count 1 value 0 kind 0
    add 256 type 4 count 1 value w kind 0
    add 257 type 4 count 1 value h kind 0
    add 258 type 3 count 1 value 16 kind 0
    add 259 type 3 count 1 value 1 kind 0
    add 262 type 3 count 1 value 32803 kind 0
    o := flt + 148
    add_string 271 from (o + 1) size (u8 o)
    add_string 272 from (o + 2 + (u8 o)) size (u8 (o + 1 + (u8 o)))
    add 273 type 4 count 1 value 0 kind 2
    fo := 1
    ((u32 (rh + 25)) = 3).if { fo := 3 }
    ((u32 (rh + 25)) = 5).if { fo := 8 }
    ((u32 (rh + 25)) = 6).if { fo := 6 }
    add 274 type 3 count 1 value fo kind 0
    add 277 type 3 count 1 value 1 kind 0
    add 278 type 4 count 1 value h kind 0
    add 279 type 4 count 1 value (w * h * 2) kind 0
    add 284 type 3 count 1 value 1 kind 0
    add 33421 type 3 count 2 value (2 | (2 << 16)) kind 0
    add 33422 type 1 count 4 value (((cfa.at 0) & 3) | (((cfa.at 1) & 3) << 8) | (((cfa.at 2) & 3) << 16) | (((cfa.at 3) & 3) << 24)) kind 0
    add_cmt (mp, ml)
    add 50706 type 1 count 4 value (1 | (4 << 8)) kind 0
    add 50707 type 1 count 4 value (1 | (1 << 8)) kind 0
    // UniqueCameraModel: "make model"
    pos := ext_n
    (o + 1).to (o + (u8 o)) do { i:Int e8 (u8 i) }
    e8 32
    (o + 2 + (u8 o)).to (o + 1 + (u8 o) + (u8 (o + 1 + (u8 o)))) do { i:Int e8 (u8 i) }
    e8 0
    add_data 50708 type 2 count (ext_n - pos) from pos
    add 50713 type 3 count 2 value (2 | (2 << 16)) kind 0
    // BlackLevel per CFA position: black + cblack[colour] (+ the cblack pattern when LibRaw has one).
    pos := ext_n
    0.to 3 do { i:Int
      bl := (u32 (rh + 29)) + (u32 (rh + 41 + 4 * ((cfa.at i) >> 8)))
      ((c4 > 0) && {c5 > 0} && {nb >= 6 + c4 * c5}).if {
        bl := bl + (u32 (rh + 41 + 4 * (6 + ((i >> 1) % c4) * c5 + ((i & 1) % c5))))
      }
      e32 bl
    }
    add_data 50714 type 4 count 4 from pos
    // WhiteLevel: the real saturation level when LibRaw has it (Canon 250D: 14338, not 16383), as
    // raw developers use for the source file; else the format maximum.
    k := o + 2 + (u8 o) + (u8 (o + 1 + (u8 o)))
    ((k + 4 <= rh + (u32 (rh - 4))) && {(u32 k) > 0}).if {
      add 50717 type 4 count 1 value (u32 k) kind 0
    } else {
      add 50717 type 4 count 1 value (u32 (rh + 33)) kind 0
    }
    // ColorMatrix1 (XYZ -> camera, LibRaw's cam_xyz, D65), when LibRaw knows the camera.
    ((u32 (flt + 32)) != 0).if {
      pos := ext_n
      0.to 8 do { i:Int
        e32 (Nova_rawin.fixed (u32 (flt + 32 + 4 * i)) scale 10000)
        e32 10000
      }
      add_data 50721 type 10 count 9 from pos
      add 50778 type 3 count 1 value 21 kind 0
    }
    // AsShotNeutral: green multiplier / colour multiplier.
    ((u32 flt) != 0).if {
      pos := ext_n
      0.to 2 do { i:Int
        e32 (Nova_rawin.ratio (u32 (flt + 4), u32 (flt + 4 * i)) scale 1000000)
        e32 1000000
      }
      add_data 50728 type 5 count 3 from pos
    }
    pos := ext_n
    e32 top
    e32 left
    e32 (top + vh)
    e32 (left + vw)
    add_data 50829 type 4 count 4 from pos
    merge_cmt1 (mp, ml)
    finish name pixels 0 size (w, h)
  )
