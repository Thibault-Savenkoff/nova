Header
  + name := Nova_zlib
  // zlib (loaded at run time, dlopen) for the PNG output: rows filtered like libpng does (per row,
  // the filter with the smallest sum of absolute values), then deflated in parallel chunks.
  // Without zlib the caller falls back to stored (uncompressed) blocks.
  - include := `
#include <dlfcn.h>
#include <stdlib.h>
#include <string.h>
#include <sys/mman.h>
#include <sys/wait.h>
#include <unistd.h>
`;
  - external := `
/* z_stream of zlib 1.x (stable ABI), declared here: nova builds without zlib headers. */
typedef struct {
  const unsigned char *next_in; unsigned avail_in; unsigned long total_in;
  unsigned char *next_out; unsigned avail_out; unsigned long total_out;
  const char *msg; void *state; void *zalloc, *zfree, *opaque;
  int data_type; unsigned long adler, reserved;
} nz_stream;
static int (*nz_compress2)(unsigned char *, unsigned long *, const unsigned char *, unsigned long, int);
static unsigned long (*nz_bound)(unsigned long);
static int (*nz_init2)(nz_stream *, int, int, int, int, int, const char *, int);
static int (*nz_deflate_)(nz_stream *, int);
static int (*nz_end)(nz_stream *);
static unsigned long (*nz_adler)(unsigned long, const unsigned char *, unsigned);
static unsigned long (*nz_adler_combine)(unsigned long, unsigned long, long);
static int nz_state;
static unsigned char *nz_out;
static unsigned long nz_n;

static int nz_open(void) {
  void *l;
  if (nz_state) return nz_state > 0;
  nz_state = -1;
  l = dlopen("libz.so.1", RTLD_NOW | RTLD_LOCAL);
  if (!l) l = dlopen("libz.dylib", RTLD_NOW | RTLD_LOCAL);
  if (!l) return 0;
#define NZ(v, s) if (!(*(void **)&v = dlsym(l, s))) return 0;
  NZ(nz_compress2, "compress2") NZ(nz_bound, "compressBound") NZ(nz_init2, "deflateInit2_")
  NZ(nz_deflate_, "deflate") NZ(nz_end, "deflateEnd") NZ(nz_adler, "adler32") NZ(nz_adler_combine, "adler32_combine")
#undef NZ
  nz_state = 1;
  return 1;
}

/* zlib stream of src[0, n) into nz_out / nz_n. */
static int nz_deflate(const unsigned char *src, unsigned long n, int level) {
  if (!nz_open()) return 0;
  free(nz_out);
  nz_n = nz_bound(n);
  nz_out = malloc(nz_n);
  return nz_out && nz_compress2(nz_out, &nz_n, src, n, level) == 0;
}

static int nz_paeth(int a, int b, int c) {
  int p = a + b - c, pa = abs(p - a), pb = abs(p - b), pc = abs(p - c);
  return pa <= pb && pa <= pc ? a : pb <= pc ? b : c;
}

/* Filtered PNG rows y0..y1-1 of rgba (4 bytes per pixel) into o, bpp bytes per pixel kept. */
static void nz_filter(const unsigned char *rgba, int w, int bpp, int y0, int y1, unsigned char *o) {
  long row = 1 + (long)w * bpp, x, best, s;
  unsigned char *cur = malloc(row), *prev = calloc(row, 1), *t;
  int f, bf, y;
  if (y0 > 0) for (x = 0; x < w; x++) memcpy(prev + x * bpp, rgba + ((long)(y0 - 1) * w + x) * 4, bpp);
  for (y = y0; y < y1; y++, o += row) {
    for (x = 0; x < w; x++) memcpy(cur + x * bpp, rgba + ((long)y * w + x) * 4, bpp);
    best = -1;
    bf = 0;
    /* libpng's heuristic: the filter with the smallest sum of |signed residuals|. */
    for (f = 0; f < 5; f++) {
      for (s = 0, x = 0; x < row - 1; x++) {
        int a = x >= bpp ? cur[x - bpp] : 0, b = prev[x], c = x >= bpp ? prev[x - bpp] : 0;
        int p = f == 0 ? 0 : f == 1 ? a : f == 2 ? b : f == 3 ? (a + b) >> 1 : nz_paeth(a, b, c);
        signed char r = cur[x] - p;
        s += r < 0 ? -r : r;
        if (best >= 0 && s >= best) break;
      }
      if (best < 0 || s < best) { best = s; bf = f; }
    }
    for (x = 0; x < row - 1; x++) {
      int a = x >= bpp ? cur[x - bpp] : 0, b = prev[x], c = x >= bpp ? prev[x - bpp] : 0;
      int p = bf == 0 ? 0 : bf == 1 ? a : bf == 2 ? b : bf == 3 ? (a + b) >> 1 : nz_paeth(a, b, c);
      o[1 + x] = cur[x] - p;
    }
    o[0] = bf;
    t = prev; prev = cur; cur = t;
  }
  free(cur);
  free(prev);
}

/* PNG image data (IDAT payload) of rgba, bpp = 3 (RGB) or 4 (RGBA). The rows are cut in chunks
   (count from the image size only: same file on every machine), each filtered and deflated by its
   own process (full flush between chunks, as pigz does), then joined into one zlib stream.
   Processes and shared memory as in Nova_par (WebAssembly: replicas). */
static int nz_png(const unsigned char *rgba, int w, int h, int bpp) {
  long row = 1 + (long)w * bpp, cap, i, n = row * h;
  int nc = n / 4000000, per, par, threads;
  unsigned char *sh, *p;
  long *len;
  unsigned long *ad, adler;
  char *e = getenv("NOVA_THREADS");
  if (!nz_open()) return 0;
  if (nc < 1) nc = 1;
  if (nc > 16) nc = 16;
  if (nc > h) nc = h;
  per = (h + nc - 1) / nc;
  nc = (h + per - 1) / per;
  cap = nz_bound(row * per) + 1024;
  sh = nova_shared(cap * nc + nc * 16);
  if (!sh) return 0;
  len = (long *)(sh + cap * nc);
  ad = (unsigned long *)(len + nc);
  threads = e ? atoi(e) : 2;
  par = threads != 1 && nc > 1;
  for (i = 0; i < nc; i++) {
    pid_t pid = np_count() > 1 ? (np_own() ? -1 : 1) : par ? fork() : -1;
    if (pid == 0 || pid < 0) {
      int y0 = i * per, y1 = y0 + per > h ? h : y0 + per;
      unsigned char *raw = malloc(row * (y1 - y0));
      nz_stream z;
      memset(&z, 0, sizeof z);
      nz_filter(rgba, w, bpp, y0, y1, raw);
      ad[i] = nz_adler(1, raw, row * (y1 - y0));
      len[i] = -1;
      if (nz_init2(&z, 6, 8, -15, 8, 0, "1.2.11", sizeof z) == 0) {
        z.next_in = raw; z.avail_in = row * (y1 - y0);
        z.next_out = sh + cap * i; z.avail_out = cap;
        if (nz_deflate_(&z, i == nc - 1 ? 4 : 3) == (i == nc - 1 ? 1 : 0)) len[i] = cap - z.avail_out;
        nz_end(&z);
      }
      free(raw);
      if (pid == 0) _exit(0);
    }
  }
  if (par) while (wait(0) > 0) ;
  np_merge();
  free(nz_out);
  nz_n = 2 + 4;
  for (i = 0; i < nc; i++) { if (len[i] < 0) { nova_unshare(sh, cap * nc + nc * 16); return 0; } nz_n += len[i]; }
  nz_out = p = malloc(nz_n);
  *p++ = 0x78; *p++ = 0x9C;
  adler = ad[0];
  for (i = 0; i < nc; i++) {
    memcpy(p, sh + cap * i, len[i]);
    p += len[i];
    if (i > 0) adler = nz_adler_combine(adler, ad[i], (i == nc - 1 ? n - (long)per * row * i : (long)per * row));
  }
  *p++ = adler >> 24; *p++ = adler >> 16; *p++ = adler >> 8; *p++ = adler;
  nova_unshare(sh, cap * nc + nc * 16);
  return 1;
}

/* TIFF strips (Compression 8 = zlib with Predictor 2, horizontal differences) of an image: bits 8
   (src = RGBA bytes, spp of the 4 kept) or 16 (src = spp unsigned shorts per pixel), written in
   big-endian order when big. Strips as the PNG chunks (count from the size), one process each.
   Without zlib: uncompressed strips, nz_comp = 1. Output: nz_out, strip i at nz_soff[i], nz_slen[i]. */
static long nz_soff[16], nz_slen[16];
static int nz_comp, nz_rps, nz_pred = 1;   /* nz_pred 0: no Predictor (float samples) */
static void nz_strip(const void *src, int bits, int w, int spp, int big, int y0, int y1, int pred, unsigned char *o) {
  int y, x, s, B = bits / 8;
  for (y = y0; y < y1; y++)
    for (x = 0; x < w; x++)
      for (s = 0; s < spp; s++) {
        long i = (long)y * w + x;
        unsigned v = bits == 8 ? ((const unsigned char *)src)[i * 4 + s] : ((const unsigned short *)src)[i * spp + s];
        unsigned l = x == 0 || !pred ? 0 : bits == 8 ? ((const unsigned char *)src)[(i - 1) * 4 + s] : ((const unsigned short *)src)[(i - 1) * spp + s];
        v = (v - l) & (bits == 8 ? 0xFF : 0xFFFF);
        if (B == 1) *o++ = v;
        else if (big) { *o++ = v >> 8; *o++ = v; }
        else { *o++ = v; *o++ = v >> 8; }
      }
}
static int nz_tiff(const void *src, int bits, int w, int h, int spp, int big) {
  long rowb = (long)w * spp * (bits / 8), cap, i, pos;
  int nc = rowb * h / 4000000, per, par;
  unsigned char *sh;
  long *len;
  char *e = getenv("NOVA_THREADS");
  if (nc < 1) nc = 1;
  if (nc > 16) nc = 16;
  if (nc > h) nc = h;
  per = (h + nc - 1) / nc;
  nc = (h + per - 1) / per;
  nz_rps = per;
  free(nz_out);
  if (!nz_open()) {
    nz_comp = 1;
    nz_n = rowb * h;
    nz_out = malloc(nz_n);
    for (i = 0; i < nc; i++) {
      int y0 = i * per, y1 = y0 + per > h ? h : y0 + per;
      nz_soff[i] = rowb * y0;
      nz_slen[i] = rowb * (y1 - y0);
      nz_strip(src, bits, w, spp, big, y0, y1, 0, nz_out + nz_soff[i]);
    }
    return nc;
  }
  nz_comp = 8;
  cap = nz_bound(rowb * per) + 1024;
  sh = nova_shared(cap * nc + nc * 8);
  if (!sh) return 0;
  len = (long *)(sh + cap * nc);
  par = !(e && atoi(e) == 1) && nc > 1;
  for (i = 0; i < nc; i++) {
    pid_t pid = np_count() > 1 ? (np_own() ? -1 : 1) : par ? fork() : -1;
    if (pid == 0 || pid < 0) {
      int y0 = i * per, y1 = y0 + per > h ? h : y0 + per;
      unsigned char *raw = malloc(rowb * (y1 - y0));
      unsigned long n = cap;
      nz_strip(src, bits, w, spp, big, y0, y1, nz_pred, raw);
      len[i] = nz_compress2(sh + cap * i, &n, raw, rowb * (y1 - y0), 6) == 0 ? (long)n : -1;
      free(raw);
      if (pid == 0) _exit(0);
    }
  }
  if (par) while (wait(0) > 0) ;
  np_merge();
  for (nz_n = 0, i = 0; i < nc; i++) { if (len[i] < 0) { nova_unshare(sh, cap * nc + nc * 8); return 0; } nz_n += len[i]; }
  nz_out = malloc(nz_n);
  for (pos = 0, i = 0; i < nc; i++) {
    memcpy(nz_out + pos, sh + cap * i, len[i]);
    nz_soff[i] = pos;
    nz_slen[i] = len[i];
    pos += len[i];
  }
  nova_unshare(sh, cap * nc + nc * 8);
  return nc;
}

/* zlib stream src[0, n) -> nz_out / nz_n (at most cap bytes). */
static int nz_inflate(const unsigned char *src, unsigned long n, unsigned long cap) {
  static int (*unc)(unsigned char *, unsigned long *, const unsigned char *, unsigned long);
  if (!nz_open()) return 0;
  if (!unc) *(void **)&unc = dlsym(dlopen("libz.so.1", RTLD_NOW | RTLD_LOCAL), "uncompress");
  free(nz_out);
  nz_n = cap;
  nz_out = malloc(cap);
  return unc && nz_out && unc(nz_out, &nz_n, src, n) == 0;
}
`;

Public

  // Output of the last call: zlib stream in data, size bytes.
  - data:C_array Uint8 <- `nz_out`:C_array Uint8

  - size:Int <- `nz_n`:Int

  - deflate buf:C_array Uint8 size n:Int :Boolean <- `nz_deflate(@buf, @n, 9)`:Int != 0

  - png rgba:C_array Uint8 size (w,h:Int) planes np:Int :Boolean <- `nz_png(@rgba, @w, @h, @np)`:Int != 0

  // TIFF strips of an RGBA (bits 8) or unsigned short (bits 16) image: returns the strip count.
  - tiff src:Pointer bits b:Int size (w,h:Int) planes np:Int big bg:Boolean :Int <-
  ( + g:Int
    g := bg.to_int
    `nz_tiff(@src, @b, @w, @h, @np, @g)`:Int
  )

  // False: strips without horizontal differencing (the Predictor 2 of TIFF is for integers).
  - set_predictor p:Boolean <- ( + i:Int i := p.to_int; `nz_pred = @i`; )

  - compression:Int <- `nz_comp`:Int

  - rows_per_strip:Int <- `nz_rps`:Int

  - strip_offset i:Int :Int <- `nz_soff[@i]`:Int

  - strip_length i:Int :Int <- `nz_slen[@i]`:Int

  // zlib stream data[p, p + n) inflated into data (at most cap bytes).
  - inflate buf:C_array Uint8 from p:Int size n:Int max cap:Int :Boolean <- `nz_inflate(@buf + @p, @n, @cap)`:Int != 0
