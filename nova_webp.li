Header
  + name := Nova_webp
  // WebP output through libwebp, loaded at run time (dlopen): nova runs without it (.webp is then
  // refused). Advanced API (structs from the vendored headers, third_party/libwebp 1.6.0; libwebp
  // refuses another ABI major version at WebPConfigInitInternal). The file is rebuilt as an extended
  // WebP (VP8X) to carry the metadata: ICCP, EXIF (TIFF stream), XMP.
  // Effort, measured on a 24 Mpx photo and a 1080p screenshot: lossy method 3 (as small as the
  // default 4, 1.4x faster); lossless effort 90 up to 8 Mpx (graphics: -4 % vs 70), 25 above
  // (photos: same size, 5x faster). libwebp's thread_level barely helps (one image, no tiles).
  - include := `
#include <dlfcn.h>
#include <stdlib.h>
#include <string.h>
#include <stdint.h>
#include "third_party/libwebp/webp/encode.h"
`;
  - external := `
static void *nw_lib;
static __typeof__(WebPConfigInitInternal) *nw_cfg_init;
static __typeof__(WebPPictureInitInternal) *nw_pic_init;
static __typeof__(WebPPictureImportRGB) *nw_import_rgb;
static __typeof__(WebPPictureImportRGBA) *nw_import_rgba;
static __typeof__(WebPMemoryWriterInit) *nw_wr_init;
static __typeof__(WebPMemoryWrite) *nw_wr_write;
static __typeof__(WebPMemoryWriterClear) *nw_wr_clear;
static __typeof__(WebPEncode) *nw_enc;
static __typeof__(WebPPictureFree) *nw_pic_free;
static const char *nw_msg;

static int nw_open(void) {
  if (nw_lib) return 1;
  nw_lib = dlopen("libwebp.so.7", RTLD_NOW | RTLD_LOCAL);
  if (!nw_lib) nw_lib = dlopen("libwebp.so", RTLD_NOW | RTLD_LOCAL);
  if (!nw_lib) nw_lib = dlopen("libwebp.dylib", RTLD_NOW | RTLD_LOCAL);
  if (!nw_lib) { nw_msg = "libwebp not found (install libwebp)"; return 0; }
#define NW(v, s) if (!(*(void **)&v = dlsym(nw_lib, s))) { nw_msg = "libwebp: missing " s; nw_lib = 0; return 0; }
  NW(nw_cfg_init, "WebPConfigInitInternal") NW(nw_pic_init, "WebPPictureInitInternal")
  NW(nw_import_rgb, "WebPPictureImportRGB") NW(nw_import_rgba, "WebPPictureImportRGBA")
  NW(nw_wr_init, "WebPMemoryWriterInit") NW(nw_wr_write, "WebPMemoryWrite") NW(nw_wr_clear, "WebPMemoryWriterClear")
  NW(nw_enc, "WebPEncode") NW(nw_pic_free, "WebPPictureFree")
#undef NW
  return 1;
}

static unsigned char *nw_out;
static long nw_n, nw_cap;

static void nw_put(const void *p, long n) {
  if (nw_n + n > nw_cap) {
    nw_cap = (nw_n + n) * 2 + 65536;
    nw_out = realloc(nw_out, nw_cap);
  }
  memcpy(nw_out + nw_n, p, n);
  nw_n += n;
}
static void nw_le(unsigned long v, int n) { unsigned char b[4] = { v, v >> 8, v >> 16, v >> 24 }; nw_put(b, n); }
static void nw_chunk(const char *id, const unsigned char *p, long n) {
  nw_put(id, 4); nw_le(n, 4); nw_put(p, n);
  if (n & 1) nw_le(0, 1);
}
static unsigned long nw_u32(const unsigned char *p) { return p[0] | p[1] << 8 | p[2] << 16 | (unsigned long)p[3] << 24; }

/* rgba (4 bytes per pixel, np = 3: alpha ignored) -> WebP in nw_out / nw_n. 1 on success, else 0 with nw_msg. */
static int nw_encode(const unsigned char *rgba, int w, int h, int np, int lossless, int q,
                     const unsigned char *exif, long en, const unsigned char *icc, long icn, const unsigned char *xmp, long xn) {
  WebPConfig cfg;
  WebPPicture pic;
  WebPMemoryWriter wr;
  const uint8_t *o;
  size_t n;
  long i, p;
  int alph = 0, ok;
  nw_msg = 0;
  if (!nw_open()) return 0;
  if (w > 16383 || h > 16383) { nw_msg = "WebP images are at most 16383x16383"; return 0; }
  if (!nw_cfg_init(&cfg, WEBP_PRESET_DEFAULT, q, WEBP_ENCODER_ABI_VERSION) || !nw_pic_init(&pic, WEBP_ENCODER_ABI_VERSION)) {
    nw_msg = "libwebp version differs from 1.x (see third_party/libwebp)";
    return 0;
  }
  cfg.lossless = lossless;
  cfg.method = lossless ? 4 : 3;
  if (lossless) cfg.quality = (long)w * h <= 8000000 ? 90 : 25;
  cfg.thread_level = 1;
  pic.use_argb = lossless;
  pic.width = w;
  pic.height = h;
  if (np == 3) {
    unsigned char *rgb = malloc((size_t)w * h * 3);
    if (!rgb) { nw_msg = "out of memory"; return 0; }
    for (i = 0; i < (long)w * h; i++) memcpy(rgb + i * 3, rgba + i * 4, 3);
    ok = nw_import_rgb(&pic, rgb, w * 3);
    free(rgb);
  } else {
    ok = nw_import_rgba(&pic, rgba, w * 4);
  }
  nw_wr_init(&wr);
  pic.writer = nw_wr_write;
  pic.custom_ptr = &wr;
  ok = ok && nw_enc(&cfg, &pic);
  nw_pic_free(&pic);
  o = wr.mem;
  n = wr.size;
  if (!ok || n < 12) { nw_msg = "WebP encoding failed"; nw_wr_clear(&wr); return 0; }
  for (p = 12; p + 8 <= (long)n; p += 8 + ((nw_u32(o + p + 4) + 1) & ~1UL)) if (!memcmp(o + p, "ALPH", 4)) alph = 1;
  nw_n = 0;
  nw_put("RIFF\0\0\0\0WEBP", 12);
  if (en || icn || xn || alph) {
    unsigned char x[10] = { 0 };
    x[0] = (icn ? 0x20 : 0) | (np == 4 ? 0x10 : 0) | (en ? 0x08 : 0) | (xn ? 0x04 : 0);
    x[4] = (w - 1); x[5] = (w - 1) >> 8; x[6] = (w - 1) >> 16;
    x[7] = (h - 1); x[8] = (h - 1) >> 8; x[9] = (h - 1) >> 16;
    nw_chunk("VP8X", x, 10);
    if (icn) nw_chunk("ICCP", icc, icn);
  }
  for (p = 12; p + 8 <= (long)n; p += 8 + ((nw_u32(o + p + 4) + 1) & ~1UL))
    if (memcmp(o + p, "VP8X", 4) && p + 8 + (long)nw_u32(o + p + 4) <= (long)n) nw_chunk((const char *)o + p, o + p + 8, nw_u32(o + p + 4));
  if (en) nw_chunk("EXIF", exif, en);
  if (xn) nw_chunk("XMP ", xmp, xn);
  nw_out[4] = (nw_n - 8); nw_out[5] = (nw_n - 8) >> 8; nw_out[6] = (nw_n - 8) >> 16; nw_out[7] = (nw_n - 8) >> 24;
  nw_wr_clear(&wr);
  return 1;
}
`;

Public

  // rgba: 4 bytes per pixel (np 3: alpha ignored). Metadata: buf[pos, pos + len) (len 0: none).
  // Then data, size; message when it fails.
  - encode rgba:C_array Uint8 size (w,h:Int) planes np:Int lossless ll:Boolean quality q:Int exif (e:C_array Uint8, ep,en:Int) icc (c:C_array Uint8, cp,cn:Int) xmp (x:C_array Uint8, xp,xn:Int) :Boolean <-
  ( + l:Int
    l := ll.to_int
    `nw_encode(@rgba, @w, @h, @np, @l, @q, @e + @ep, @en, @c + @cp, @cn, @x + @xp, @xn)`:Int != 0
  )

  - data:C_array Uint8 <- `nw_out`:C_array Uint8

  - size:Int <- `nw_n`:Int

  - message:String <-
  ( + result:String_buffer
    result := String_buffer.create 64
    result.from_external_copy (`nw_msg`:C_array Char)
    result.to_string
  )
