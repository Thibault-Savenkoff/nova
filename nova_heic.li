Header
  + name := Nova_heic
  // HEIC / HEIF (and AVIF when libheif has a decoder for it) import through libheif, loaded at run
  // time (dlopen): nova builds without libheif headers, and runs without it (HEIC is then refused).
  // Primary image only, decoded to 8-bit RGBA with its rotation/mirror applied, so the EXIF
  // orientation tag is reset to 1. Metadata: EXIF, XMP, ICC as the JPEG segments NOVA already keeps.
  // HDR: the ISO 21496-1 gain map of a `tmap` item (iPhone photos) is decoded too (8-bit RGB) with its
  // metadata; libheif applies its rotation like the primary's.
  // ponytail: depth maps and other auxiliary images are not kept; burst/sequence files give their
  // primary image only; a 10-bit primary is read as 8 bits (iPhone HEIC screenshots: at most 2 of
  // 1024 steps off, invisible; keeping 10 bits would need 16-bit planes in the codec and cost size).
  // Export (nova decode x.nova y.avif|heic; a lossy AVIF with an HDR gain map goes through libavif,
  // na_export below): libheif's default encoder (AVIF: aom, HEIC: x265), 8-bit
  // RGB(A); lossless = identity matrix (nclx 0) and 4:4:4, so RGB comes back exactly. EXIF, XMP, ICC.
  // ponytail: the EXIF orientation is not turned into irot/imir (NOVA pixels from HEIC or RAW are
  // already upright; a rotated JPEG source exported to HEIF shows unrotated).
  - include := `
#include <dlfcn.h>
#include <math.h>
#include <stdio.h>
#include <stdlib.h>
#include <string.h>
#include <unistd.h>
#ifdef __APPLE__
#include <mach-o/dyld.h>
#endif
`;
  - external := `
struct nh_err { int code; int subcode; const char *message; };
static void *nh_lib;
static void *(*nh_context_alloc)(void);
static void (*nh_context_free)(void *);
static struct nh_err (*nh_read_file)(void *, const char *, const void *);
static struct nh_err (*nh_primary)(void *, void **);
static void (*nh_handle_release)(void *);
static int (*nh_handle_width)(void *);
static int (*nh_handle_height)(void *);
static int (*nh_has_alpha)(void *);
static struct nh_err (*nh_decode)(void *, void **, int, int, const void *);
static const unsigned char *(*nh_plane)(void *, int, int *);
static int (*nh_image_width)(void *, int);
static int (*nh_image_height)(void *, int);
static void (*nh_image_release)(void *);
static int (*nh_meta_count)(void *, const char *);
static int (*nh_meta_ids)(void *, const char *, unsigned int *, int);
static const char *(*nh_meta_type)(void *, unsigned int);
static const char *(*nh_meta_ctype)(void *, unsigned int);
static size_t (*nh_meta_size)(void *, unsigned int);
static struct nh_err (*nh_meta_get)(void *, unsigned int, void *);
static size_t (*nh_icc_size)(void *);
static struct nh_err (*nh_icc_get)(void *, void *);
static int (*nh_major)(void);

static int nh_open(void) {
  if (nh_lib) return 1;
  nh_lib = dlopen("libheif.so.1", RTLD_NOW | RTLD_LOCAL);
  if (!nh_lib) nh_lib = dlopen("libheif.so", RTLD_NOW | RTLD_LOCAL);
  if (!nh_lib) nh_lib = dlopen("libheif.1.dylib", RTLD_NOW | RTLD_LOCAL);
  if (!nh_lib) return 0;
#define NH(v, s) if (!(*(void **)&v = dlsym(nh_lib, s))) return 0;
  NH(nh_context_alloc, "heif_context_alloc") NH(nh_context_free, "heif_context_free")
  NH(nh_read_file, "heif_context_read_from_file") NH(nh_primary, "heif_context_get_primary_image_handle")
  NH(nh_handle_release, "heif_image_handle_release") NH(nh_handle_width, "heif_image_handle_get_width")
  NH(nh_handle_height, "heif_image_handle_get_height") NH(nh_has_alpha, "heif_image_handle_has_alpha_channel")
  NH(nh_decode, "heif_decode_image") NH(nh_plane, "heif_image_get_plane_readonly")
  NH(nh_image_width, "heif_image_get_width") NH(nh_image_height, "heif_image_get_height")
  NH(nh_image_release, "heif_image_release")
  NH(nh_meta_count, "heif_image_handle_get_number_of_metadata_blocks")
  NH(nh_meta_ids, "heif_image_handle_get_list_of_metadata_block_IDs")
  NH(nh_meta_type, "heif_image_handle_get_metadata_type")
  NH(nh_meta_ctype, "heif_image_handle_get_metadata_content_type")
  NH(nh_meta_size, "heif_image_handle_get_metadata_size") NH(nh_meta_get, "heif_image_handle_get_metadata")
  NH(nh_icc_size, "heif_image_handle_get_raw_color_profile_size")
  NH(nh_icc_get, "heif_image_handle_get_raw_color_profile")
  NH(nh_major, "heif_get_version_number_major")
#undef NH
  /* The prototypes above are libheif 1.x. */
  if (nh_major() != 1) { nh_lib = 0; return 0; }
  return 1;
}

/* Gain map part of libheif (1.18+): optional, HDR is skipped without it. */
static struct nh_err (*nh_primary_id)(void *, unsigned int *);
static int (*nh_item_ids)(void *, unsigned int *, int);
static unsigned int (*nh_item_type)(void *, unsigned int);
static struct nh_err (*nh_item_data)(void *, unsigned int, int *, unsigned char **, size_t *);
static void (*nh_item_data_free)(void *, unsigned char **);
static size_t (*nh_item_refs)(void *, unsigned int, int, unsigned int *, unsigned int **);
static void (*nh_item_refs_free)(void *, unsigned int **);
static struct nh_err (*nh_handle_of)(void *, unsigned int, void **);

static int nh_open_gm(void) {
#define NG(v, s) if (!(*(void **)&v = dlsym(nh_lib, s))) return 0;
  NG(nh_primary_id, "heif_context_get_primary_image_ID") NG(nh_item_ids, "heif_context_get_list_of_item_IDs")
  NG(nh_item_type, "heif_item_get_item_type") NG(nh_item_data, "heif_item_get_item_data")
  NG(nh_item_data_free, "heif_release_item_data") NG(nh_item_refs, "heif_context_get_item_references")
  NG(nh_item_refs_free, "heif_release_item_references") NG(nh_handle_of, "heif_context_get_image_handle")
#undef NG
  return 1;
}

/* Gain map of the last pixel load: RGBA (gray in RGB), its ISO 21496-1 metadata. nh_gm_w 0: none. */
static int nh_gm_w, nh_gm_h;
static unsigned char *nh_gm;
static unsigned char nh_iso[256];
static int nh_iso_n;

/* tmap item with inputs (primary, gain map) -> nh_gm, nh_iso. */
static void nh_gainmap(void *ctx) {
  unsigned int ids[8192], pid, rt, *to;
  unsigned char *d;
  size_t sz, nr;
  int i, n, k, comp, stride, y, x;
  void *h, *img;
  if (!nh_open_gm() || nh_primary_id(ctx, &pid).code) return;
  n = nh_item_ids(ctx, ids, 8192);
  for (i = 0; i < n; i++) {
    if (nh_item_type(ctx, ids[i]) != 0x746d6170) continue;   /* 'tmap' */
    for (k = 0; (nr = nh_item_refs(ctx, ids[i], k, &rt, &to)) > 0; k++) {
      if (rt == 0x64696d67 && nr == 2 && to[0] == pid && nh_handle_of(ctx, to[1], &h).code == 0) {   /* 'dimg' */
        if (nh_decode(h, &img, 1, 10, 0).code == 0) {
          const unsigned char *p = nh_plane(img, 10, &stride);
          int w = nh_image_width(img, 10), hh = nh_image_height(img, 10);
          if (p && nh_item_data(ctx, ids[i], &comp, &d, &sz).code == 0) {
            if (sz <= sizeof nh_iso && (nh_gm = malloc((size_t)w * hh * 4))) {
              for (y = 0; y < hh; y++)
                for (x = 0; x < w; x++) {
                  memcpy(nh_gm + ((size_t)y * w + x) * 4, p + (size_t)y * stride + x * 3, 3);
                  nh_gm[((size_t)y * w + x) * 4 + 3] = 255;
                }
              memcpy(nh_iso, d, sz);
              nh_iso_n = sz;
              nh_gm_w = w;
              nh_gm_h = hh;
            }
            nh_item_data_free(ctx, &d);
          }
          nh_image_release(img);
        }
        nh_handle_release(h);
      }
      nh_item_refs_free(ctx, &to);
      if (nh_gm_w) return;
    }
  }
}

/* Results of the last nh_load. */
static int nh_w, nh_h, nh_alpha;
static unsigned char *nh_px;
static unsigned char *nh_meta;
static long nh_meta_n, nh_meta_cap;
static const char *nh_msg;

static void nh_put(const void *p, long n) {
  if (nh_meta_n + n > nh_meta_cap) {
    nh_meta_cap = (nh_meta_n + n) * 2 + 1024;
    nh_meta = realloc(nh_meta, nh_meta_cap);
  }
  memcpy(nh_meta + nh_meta_n, p, n);
  nh_meta_n += n;
}

static void nh_put32(unsigned long v) {
  unsigned char b[4] = { v >> 24, v >> 16, v >> 8, v };
  nh_put(b, 4);
}

/* One metadata block: [u32 kind][u32 length][prefix][payload]. */
static void nh_block(unsigned long kind, const char *prefix, long pn, const unsigned char *p, long n) {
  nh_put32(kind);
  nh_put32(pn + n);
  nh_put(prefix, pn);
  nh_put(p, n);
}

/* Orientation tag (0x0112) of IFD0 of a TIFF block set to 1: the pixels are already turned. */
static void nh_orient1(unsigned char *t, long n) {
  int le, i, cnt;
  unsigned long off;
  if (n < 8) return;
  le = t[0] == 'I';
#define G16(p) (le ? (t[p] | t[(p) + 1] << 8) : (t[p] << 8 | t[(p) + 1]))
#define G32(p) (le ? (t[p] | t[(p) + 1] << 8 | t[(p) + 2] << 16 | (unsigned long)t[(p) + 3] << 24) : ((unsigned long)t[p] << 24 | t[(p) + 1] << 16 | t[(p) + 2] << 8 | t[(p) + 3]))
  off = G32(4);
  if (off + 2 > (unsigned long)n) return;
  cnt = G16(off);
  for (i = 0; i < cnt && off + 2 + i * 12 + 12 <= (unsigned long)n; i++) {
    long e = off + 2 + i * 12;
    if (G16(e) == 0x0112 && G16(e + 2) == 3) {
      t[e + 8] = le ? 1 : 0;
      t[e + 9] = le ? 0 : 1;
    }
  }
#undef G16
#undef G32
}

static const char nh_exif[6] = { 'E', 'x', 'i', 'f', 0, 0 };
static const char nh_icc[14] = { 'I', 'C', 'C', '_', 'P', 'R', 'O', 'F', 'I', 'L', 'E', 0, 1, 1 };

static void nh_metadata(void *h) {
  unsigned int ids[64];
  int i, n = nh_meta_count(h, 0);
  size_t sz;
  if (n > 64) n = 64;
  n = nh_meta_ids(h, 0, ids, n);
  for (i = 0; i < n; i++) {
    const char *type = nh_meta_type(h, ids[i]);
    const char *ct = nh_meta_ctype(h, ids[i]);
    unsigned char *b;
    sz = nh_meta_size(h, ids[i]);
    if (sz == 0 || sz > 100000000) continue;
    b = malloc(sz);
    if (b && nh_meta_get(h, ids[i], b).code == 0) {
      if (type && !strcmp(type, "Exif") && sz > 4) {
        /* HEIF Exif item: u32 offset of the TIFF header after these 4 bytes. */
        unsigned long off = 4 + ((unsigned long)b[0] << 24 | b[1] << 16 | b[2] << 8 | b[3]);
        if (off < sz) {
          nh_orient1(b + off, sz - off);
          nh_block(0x41505031, nh_exif, 6, b + off, sz - off);
        }
      } else if (ct && !strcmp(ct, "application/rdf+xml")) {
        nh_block(0x41505031, "http://ns.adobe.com/xap/1.0/", 29, b, sz);
      }
    }
    free(b);
  }
  sz = nh_icc_size(h);
  if (sz > 0 && sz < 100000000) {
    unsigned char *b = malloc(sz);
    if (b && nh_icc_get(h, b).code == 0) nh_block(0x41505032, nh_icc, 14, b, sz);
    free(b);
  }
}

/* pixels: 0 = metadata only. Returns 1 on success, else 0 with nh_msg set. */
static int nh_load(const char *name, int pixels) {
  void *ctx, *h = 0, *img = 0;
  struct nh_err e;
  int ok = 0;
  nh_meta_n = 0;
  free(nh_px);
  nh_px = 0;
  if (pixels) { free(nh_gm); nh_gm = 0; nh_gm_w = 0; }
  if (!nh_open()) { nh_msg = "libheif 1.x not found (install libheif)"; return 0; }
  ctx = nh_context_alloc();
  e = nh_read_file(ctx, name, 0);
  if (e.code == 0) e = nh_primary(ctx, &h);
  if (e.code == 0) {
    nh_alpha = nh_has_alpha(h) != 0;
    nh_w = nh_handle_width(h);
    nh_h = nh_handle_height(h);
    nh_metadata(h);
    ok = 1;
    if (pixels) {
      /* colourspace RGB (1), chroma interleaved RGBA (11); channel interleaved (10) */
      e = nh_decode(h, &img, 1, 11, 0);
      ok = 0;
      if (e.code == 0) {
        int stride, y;
        const unsigned char *p = nh_plane(img, 10, &stride);
        nh_w = nh_image_width(img, 10);
        nh_h = nh_image_height(img, 10);
        nh_px = malloc((size_t)nh_w * nh_h * 4);
        if (p && nh_px) {
          for (y = 0; y < nh_h; y++) memcpy(nh_px + (size_t)y * nh_w * 4, p + (size_t)y * stride, (size_t)nh_w * 4);
          ok = 1;
        }
        nh_image_release(img);
        if (ok) nh_gainmap(ctx);
      }
    }
    nh_handle_release(h);
  }
  if (!ok) nh_msg = e.code ? e.message : "cannot decode";
  nh_context_free(ctx);
  return ok;
}

/* Encoder part of libheif, loaded on first export. */
static struct nh_err (*nh_get_encoder_e)(void *, int, void **);
static struct nh_err (*nh_set_quality)(void *, int);
static struct nh_err (*nh_set_lossless)(void *, int);
static struct nh_err (*nh_set_param)(void *, const char *, const char *);
static void (*nh_encoder_release)(void *);
static struct nh_err (*nh_image_create)(int, int, int, int, void **);
static struct nh_err (*nh_add_plane)(void *, int, int, int, int);
static unsigned char *(*nh_plane_rw)(void *, int, int *);
static struct nh_err (*nh_set_icc)(void *, const char *, const void *, size_t);
static void *(*nh_nclx_alloc)(void);
static void (*nh_nclx_free)(void *);
static struct nh_err (*nh_nclx_matrix)(void *, unsigned short);
static struct nh_err (*nh_set_nclx)(void *, const void *);
static struct nh_err (*nh_nclx_prim)(void *, unsigned short);
static struct nh_err (*nh_nclx_trc)(void *, unsigned short);
/* Start of struct heif_encoding_options (version 4+). */
struct nh_opts { unsigned char version, save_alpha, macos, two_colr; void *nclx; unsigned char no_nclx; };
static struct nh_opts *(*nh_opts_alloc)(void);
static void (*nh_opts_free)(void *);
static struct nh_err (*nh_encode)(void *, const void *, void *, const void *, void **);
static struct nh_err (*nh_add_exif)(void *, const void *, const void *, int);
static struct nh_err (*nh_add_xmp)(void *, const void *, const void *, int);
static struct nh_err (*nh_write_file)(void *, const char *);
/* HDR light level boxes (clli, mdcv): optional, older libheif lacks them. Layouts from heif_color.h. */
struct nh_clli { unsigned short max_cll, max_fall; };
struct nh_mdcv { unsigned short px[3], py[3], wx, wy; unsigned int max_lum, min_lum; };
static void (*nh_set_clli)(void *, const struct nh_clli *);
static void (*nh_set_mdcv)(void *, const struct nh_mdcv *);

static int nh_open_enc(void) {
  static int done;
  if (done) return done > 0;
  done = -1;
  if (!nh_open()) { nh_msg = "libheif not found (install libheif)"; return 0; }
#define NE(v, s) if (!(*(void **)&v = dlsym(nh_lib, s))) { nh_msg = "libheif: missing " s; return 0; }
  NE(nh_get_encoder_e, "heif_context_get_encoder_for_format") NE(nh_set_quality, "heif_encoder_set_lossy_quality")
  NE(nh_set_lossless, "heif_encoder_set_lossless") NE(nh_set_param, "heif_encoder_set_parameter_string")
  NE(nh_encoder_release, "heif_encoder_release") NE(nh_image_create, "heif_image_create")
  NE(nh_add_plane, "heif_image_add_plane") NE(nh_plane_rw, "heif_image_get_plane")
  NE(nh_set_icc, "heif_image_set_raw_color_profile") NE(nh_nclx_alloc, "heif_nclx_color_profile_alloc")
  NE(nh_nclx_free, "heif_nclx_color_profile_free") NE(nh_nclx_matrix, "heif_nclx_color_profile_set_matrix_coefficients")
  NE(nh_set_nclx, "heif_image_set_nclx_color_profile") NE(nh_encode, "heif_context_encode_image")
  NE(nh_nclx_prim, "heif_nclx_color_profile_set_color_primaries")
  NE(nh_nclx_trc, "heif_nclx_color_profile_set_transfer_characteristics")
  NE(nh_opts_alloc, "heif_encoding_options_alloc") NE(nh_opts_free, "heif_encoding_options_free")
  NE(nh_add_exif, "heif_context_add_exif_metadata") NE(nh_add_xmp, "heif_context_add_XMP_metadata")
  NE(nh_write_file, "heif_context_write_to_file")
#undef NE
  nh_set_clli = dlsym(nh_lib, "heif_image_set_content_light_level");
  nh_set_mdcv = dlsym(nh_lib, "heif_image_set_mastering_display_colour_volume");
  done = 1;
  return 1;
}

/* rgba (4 bytes per pixel; np 3: alpha dropped) -> name. av1: AVIF (else HEIC). 1 on success, else 0 with nh_msg.
   pq: HDR instead, 16-bit big-endian RGB coded PQ (rgba unused), written 10 bits with nclx
   (primaries prim, transfer 16) and no ICC. */
static int nh_export(const char *name, const unsigned char *rgba, int w, int h, int np, int av1, int lossless, int q,
                     const unsigned char *exif, long en, const unsigned char *icc, long icn, const unsigned char *xmp, long xn,
                     const unsigned char *pq, int prim) {
  void *ctx = 0, *enc = 0, *img = 0, *hdl = 0, *nclx = 0;
  struct nh_opts *opt = 0;
  unsigned char *d;
  int stride, y, ok = 0;
  struct nh_err e;
  if (!nh_open_enc()) return 0;
  ctx = nh_context_alloc();
  e = nh_get_encoder_e(ctx, av1 ? 4 : 1, &enc);
  if (e.code) { nh_msg = av1 ? "libheif has no AVIF encoder" : "libheif has no HEIC encoder"; goto end; }
  if (lossless) {
    nh_set_lossless(enc, 1);
    nh_set_param(enc, "chroma", "444");
  } else {
    nh_set_quality(enc, q);
  }
  if (pq) np = 3;
  /* chroma: interleaved RGB (10), RGBA (11), RRGGBB little-endian (14) */
  e = nh_image_create(w, h, 1, pq ? 14 : np == 4 ? 11 : 10, &img);
  if (!e.code) e = nh_add_plane(img, 10, w, h, pq ? 10 : 8);
  if (e.code) { nh_msg = e.message; goto end; }
  d = nh_plane_rw(img, 10, &stride);
  for (y = 0; pq && y < h; y++) {
    const unsigned char *s = pq + (long)y * w * 6;
    unsigned char *o = d + (long)y * stride;
    int x;
    for (x = 0; x < w * 3; x++) {
      int v = (s[x * 2] << 8 | s[x * 2 + 1]) >> 6;
      o[x * 2] = v;
      o[x * 2 + 1] = v >> 8;
    }
  }
  for (y = 0; !pq && y < h; y++) {
    const unsigned char *s = rgba + (long)y * w * 4;
    unsigned char *o = d + (long)y * stride;
    int x;
    if (np == 4) memcpy(o, s, (size_t)w * 4);
    else for (x = 0; x < w; x++) memcpy(o + x * 3, s + x * 4, 3);
  }
  if (lossless || pq) {
    nclx = nh_nclx_alloc();
    if (lossless) nh_nclx_matrix(nclx, 0);
    if (pq) { nh_nclx_prim(nclx, prim); nh_nclx_trc(nclx, 16); }
    nh_set_nclx(img, nclx);
  }
  if (icn && !pq) nh_set_icc(img, "prof", icc, icn);
  if (pq && nh_set_clli && nh_set_mdcv) {
    /* Light levels of the PQ pixels, so players can tone map them to their screen: clli = brightest
       sample and mean of each pixel's brightest channel (nits); mdcv = the image's own primaries.
       ponytail: no real mastering display behind an iPhone photo, so its peak is MaxCLL. */
    static const unsigned short p3[8] = {13250, 34500, 7500, 3000, 34000, 16000, 15635, 16450};
    static const unsigned short bt709[8] = {15000, 30000, 7500, 3000, 32000, 16500, 15635, 16450};
    const unsigned short *pr = prim == 12 ? p3 : bt709;   /* G, B, R x then y (HEVC order), white */
    double lut[1024], sum = 0, peak = 0;
    struct nh_clli cl;
    struct nh_mdcv mv;
    long i, n = (long)w * h;
    for (i = 0; i < 1024; i++) {
      double e = pow(i / 1023.0, 1 / 78.84375), v = e - 0.8359375;
      lut[i] = 10000 * pow((v < 0 ? 0 : v) / (18.8515625 - 18.6875 * e), 1 / 0.1593017578125);
    }
    for (i = 0; i < n; i++) {
      const unsigned char *s = pq + i * 6;
      int c, m = 0;
      for (c = 0; c < 3; c++) {
        int v = (s[c * 2] << 8 | s[c * 2 + 1]) >> 6;
        if (v > m) m = v;
      }
      sum += lut[m];
      if (lut[m] > peak) peak = lut[m];
    }
    cl.max_cll = (unsigned short)(peak > 65535 ? 65535 : peak + 0.5);
    cl.max_fall = (unsigned short)(n ? sum / n + 0.5 : 0);
    for (i = 0; i < 3; i++) { mv.px[i] = pr[i * 2]; mv.py[i] = pr[i * 2 + 1]; }
    mv.wx = pr[6];
    mv.wy = pr[7];
    mv.max_lum = (unsigned int)(cl.max_cll * 10000u);
    mv.min_lum = 50;   /* 0.005 nits */
    nh_set_clli(img, &cl);
    nh_set_mdcv(img, &mv);
  }
  /* The nclx box is only written when passed in the options (libheif's macOS workaround otherwise). */
  if (nclx && (opt = nh_opts_alloc()) && opt->version >= 4) { opt->nclx = nclx; opt->no_nclx = 0; opt->two_colr = 1; }
  e = nh_encode(ctx, img, enc, opt, &hdl);
  if (e.code) { nh_msg = e.message; goto end; }
  if (en) nh_add_exif(ctx, hdl, exif, en);
  if (xn) nh_add_xmp(ctx, hdl, xmp, xn);
#ifdef _WIN32
  if (nova_replica()) name = "NUL";   /* libheif writes the file itself: see nova_fopen in win/nova_win.h */
#endif
  e = nh_write_file(ctx, name);
  if (e.code) { nh_msg = e.message; goto end; }
  ok = 1;
end:
  if (opt) nh_opts_free(opt);
  if (nclx) nh_nclx_free(nclx);
  if (hdl) nh_handle_release(hdl);
  if (img) nh_image_release(img);
  if (enc) nh_encoder_release(enc);
  if (ctx) nh_context_free(ctx);
  return ok;
}

/* HEIC with an HDR gain map (ISO 21496-1 tmap): no released libheif writes one, so this loads
   libnova-heif (libheif-gainmap/build.sh: libheif + its gain-map pull request #1503, kvazaar only),
   next to nova.exe on Windows, else <nova's directory>/../lib/nova/. Writing only: every read stays
   on the system's libheif above, which gets the distribution's security fixes. Its own pointers,
   never mixed with nh_*: the two libraries' objects are not interchangeable. */
static void *ng_lib;
static void *(*ng_ctx_alloc)(void);
static void (*ng_ctx_free)(void *);
static struct nh_err (*ng_get_encoder)(void *, int, void **);
static struct nh_err (*ng_set_quality)(void *, int);
static struct nh_err (*ng_set_param)(void *, const char *, const char *);
static void (*ng_enc_release)(void *);
static struct nh_err (*ng_img_create)(int, int, int, int, void **);
static struct nh_err (*ng_add_plane)(void *, int, int, int, int);
static unsigned char *(*ng_plane)(void *, int, int *);
static void (*ng_img_release)(void *);
static struct nh_err (*ng_set_icc)(void *, const char *, const void *, size_t);
static void *(*ng_nclx_alloc)(void);
static void (*ng_nclx_free)(void *);
static struct nh_err (*ng_nclx_prim)(void *, int);
static struct nh_err (*ng_nclx_trc)(void *, int);
static struct nh_err (*ng_nclx_matrix)(void *, int);
static struct nh_err (*ng_set_nclx)(void *, const void *);
static struct nh_opts *(*ng_opts_alloc)(void);
static void (*ng_opts_free)(void *);
static struct nh_err (*ng_encode)(void *, const void *, void *, const void *, void **);
static void (*ng_handle_release)(void *);
static struct nh_err (*ng_add_exif)(void *, const void *, const void *, int);
static struct nh_err (*ng_add_xmp)(void *, const void *, const void *, int);
static struct nh_err (*ng_write)(void *, const char *);
static struct nh_err (*ng_encode_gm)(void *, const void *, void *, const void *, const void *, const unsigned char *,
                                     int, const void *, void **);

static int ng_open(void) {
  static int done;
  if (done) return done > 0;
  done = -1;
#ifdef _WIN32
  ng_lib = dlopen("libnova-heif.so", RTLD_NOW);
#else
  {
    char p[4200], *s;
#ifdef __APPLE__
    char r[4200];
    uint32_t n = sizeof r;
    if (_NSGetExecutablePath(r, &n) || !realpath(r, p)) return 0;
#else
    ssize_t n = readlink("/proc/self/exe", p, sizeof p - 64);
    if (n <= 0) return 0;
    p[n] = 0;
#endif
    if (!(s = strrchr(p, '/'))) return 0;
#ifdef __APPLE__
    strcpy(s, "/../lib/nova/libnova-heif.dylib");
#else
    strcpy(s, "/../lib/nova/libnova-heif.so");
#endif
    ng_lib = dlopen(p, RTLD_NOW | RTLD_LOCAL);
  }
#endif
  if (!ng_lib) return 0;
#define NG(v, s) if (!(*(void **)&v = dlsym(ng_lib, s))) return 0;
  NG(ng_ctx_alloc, "heif_context_alloc") NG(ng_ctx_free, "heif_context_free")
  NG(ng_get_encoder, "heif_context_get_encoder_for_format") NG(ng_set_quality, "heif_encoder_set_lossy_quality")
  NG(ng_set_param, "heif_encoder_set_parameter_string") NG(ng_enc_release, "heif_encoder_release")
  NG(ng_img_create, "heif_image_create") NG(ng_add_plane, "heif_image_add_plane")
  NG(ng_plane, "heif_image_get_plane") NG(ng_img_release, "heif_image_release")
  NG(ng_set_icc, "heif_image_set_raw_color_profile") NG(ng_nclx_alloc, "heif_nclx_color_profile_alloc")
  NG(ng_nclx_free, "heif_nclx_color_profile_free") NG(ng_nclx_prim, "heif_nclx_color_profile_set_color_primaries")
  NG(ng_nclx_trc, "heif_nclx_color_profile_set_transfer_characteristics")
  NG(ng_nclx_matrix, "heif_nclx_color_profile_set_matrix_coefficients")
  NG(ng_set_nclx, "heif_image_set_nclx_color_profile") NG(ng_opts_alloc, "heif_encoding_options_alloc")
  NG(ng_opts_free, "heif_encoding_options_free") NG(ng_encode, "heif_context_encode_image")
  NG(ng_handle_release, "heif_image_handle_release") NG(ng_add_exif, "heif_context_add_exif_metadata")
  NG(ng_add_xmp, "heif_context_add_XMP_metadata") NG(ng_write, "heif_context_write_to_file")
  NG(ng_encode_gm, "heif_context_encode_gain_map_image")
#undef NG
  done = 1;
  return 1;
}

/* rgba (w x h, SDR, alpha ignored) + gain map rgba (gw x gh) + ISO 21496-1 metadata iso[0, isn) (the
   tmap item: version byte first) -> name, HEIC 8 bits, primaries prim (sRGB transfer). As na_export:
   1 on success; 0 with nh_msg; -1 when libnova-heif is not installed (write a plain HEIC instead).
   Grey gain map: coded monochrome, as the metadata then holds one channel. */
static int ng_export(const char *name, const unsigned char *rgba, int w, int h, const unsigned char *gm, int gw, int gh,
                     const unsigned char *iso, int isn, int prim, int q,
                     const unsigned char *exif, long en, const unsigned char *icc, long icn, const unsigned char *xmp, long xn) {
  void *ctx = 0, *enc = 0, *img = 0, *gimg = 0, *hdl = 0, *nclx = 0, *alt = 0;
  struct nh_opts *opt = 0;
  unsigned char *d;
  long i, n = (long)gw * gh;
  int stride, y, x, grey = 1, ok = 0;
  struct nh_err e;
  if (!ng_open()) return -1;
  if (isn < 2) { nh_msg = "gain map metadata too short"; return 0; }
  ctx = ng_ctx_alloc();
  e = ng_get_encoder(ctx, 1, &enc);
  if (!e.code) e = ng_set_quality(enc, q);
  if (!e.code) e = ng_img_create(w, h, 1, 10, &img);   /* RGB, interleaved RGB */
  if (!e.code) e = ng_add_plane(img, 10, w, h, 8);
  if (e.code) goto fail;
  d = ng_plane(img, 10, &stride);
  for (y = 0; y < h; y++)
    for (x = 0; x < w; x++) memcpy(d + (long)y * stride + x * 3, rgba + ((long)y * w + x) * 4, 3);
  nclx = ng_nclx_alloc();
  ng_nclx_prim(nclx, prim);
  ng_nclx_trc(nclx, 13);
  ng_nclx_matrix(nclx, 6);
  ng_set_nclx(img, nclx);
  /* Display P3 is said by the nclx: its ICC left out, as in na_export. */
  if (icn && prim != 12) ng_set_icc(img, "prof", icc, icn);
  if ((opt = ng_opts_alloc()) && opt->version >= 4) { opt->nclx = nclx; opt->no_nclx = 0; opt->two_colr = 1; }
  if ((e = ng_encode(ctx, img, enc, opt, &hdl)).code) goto fail;
  if (en) ng_add_exif(ctx, hdl, exif, en);
  if (xn) ng_add_xmp(ctx, hdl, xmp, xn);
  for (i = 0; i < n && grey; i++) grey = gm[i * 4] == gm[i * 4 + 1] && gm[i * 4] == gm[i * 4 + 2];
  e = grey ? ng_img_create(gw, gh, 2, 0, &gimg) : ng_img_create(gw, gh, 1, 10, &gimg);   /* monochrome / RGB */
  if (!e.code) e = ng_add_plane(gimg, grey ? 0 : 10, gw, gh, 8);
  if (e.code) goto fail;
  d = ng_plane(gimg, grey ? 0 : 10, &stride);
  for (y = 0; y < gh; y++)
    for (x = 0; x < gw; x++) {
      const unsigned char *s = gm + ((long)y * gw + x) * 4;
      if (grey) d[(long)y * stride + x] = s[0];
      else memcpy(d + (long)y * stride + x * 3, s, 3);
    }
  ng_set_param(enc, "chroma", "420");
  /* The tmap's colr: the HDR rendition, same primaries, linear (as libultrahdr writes it). Not
     optional in practice -- #1503's own reader dereferences it unchecked. The API writes the
     metadata's version byte itself. */
  alt = ng_nclx_alloc();
  ng_nclx_prim(alt, prim);
  ng_nclx_trc(alt, 8);
  ng_nclx_matrix(alt, 0);
  if ((e = ng_encode_gm(ctx, hdl, enc, gimg, 0, iso + 1, isn - 1, alt, 0)).code) goto fail;
#ifdef _WIN32
  if (nova_replica()) name = "NUL";   /* libheif writes the file itself: see nova_fopen in win/nova_win.h */
#endif
  if ((e = ng_write(ctx, name)).code) goto fail;
  ok = 1;
  goto end;
fail:
  nh_msg = e.message;
end:
  if (opt) ng_opts_free(opt);
  if (nclx) ng_nclx_free(nclx);
  if (alt) ng_nclx_free(alt);
  if (hdl) ng_handle_release(hdl);
  if (gimg) ng_img_release(gimg);
  if (img) ng_img_release(img);
  if (enc) ng_enc_release(enc);
  if (ctx) ng_ctx_free(ctx);
  return ok;
}

/* AVIF with an HDR gain map (ISO 21496-1 tmap, what libheif cannot write): libavif, loaded at run
   time like libheif. The structures below mirror avif.h 1.2+ up to the fields used (checked with
   offsetof against the real header of libavif 1.3.0); avifImageCreate / avifGainMapCreate /
   avifEncoderCreate allocate them, so later fields may grow freely. */
typedef struct { int n; unsigned d; } na_sfrac;
typedef struct { unsigned n, d; } na_ufrac;
typedef struct { unsigned char *data; size_t size; } na_rw;
typedef struct {
  unsigned width, height, depth;
  int yuv_format, yuv_range, chroma_pos;
  unsigned char *planes[3];
  unsigned row_bytes[3];
  int owns_planes;
  unsigned char *alpha;
  unsigned alpha_row;
  int owns_alpha, alpha_premul;
  na_rw icc;
  unsigned short prim, trc, matrix;
  unsigned short clli[2];
  unsigned transform_flags;
  unsigned pasp[2], clap[8];
  unsigned char irot, imir;
  na_rw exif, xmp;
  void *properties;
  size_t num_properties;
  struct na_gain_map *gain_map;
} na_image;
struct na_gain_map {
  na_image *image;
  na_sfrac min[3], max[3];
  na_ufrac gamma[3];
  na_sfrac base_offset[3], alt_offset[3];
  na_ufrac base_headroom, alt_headroom;
  int use_base_colour_space;
};
typedef struct {
  unsigned width, height, depth;
  int format, upsampling, downsampling, avoid_libyuv, ignore_alpha, alpha_premul, is_float, max_threads;
  unsigned char *pixels;
  unsigned row_bytes;
} na_rgb;
typedef struct {
  int codec_choice, max_threads, speed, keyframe_interval;
  unsigned long long timescale;
  int repetition_count;
  unsigned extra_layer_count;
  int quality, quality_alpha, min_q, max_q, min_q_alpha, max_q_alpha, tile_rows_log2, tile_cols_log2, auto_tiling;
  int scaling[4];
  size_t io_stats[2];
  char diag[256];
  void *data, *cs_options;
  int header_format;
  int quality_gain_map;
} na_encoder;

static void *na_lib;
static na_image *(*na_image_create)(unsigned, unsigned, unsigned, int);
static void (*na_image_destroy)(na_image *);
static struct na_gain_map *(*na_gain_map_create)(void);
static void (*na_rgb_defaults)(na_rgb *, const na_image *);
static int (*na_rgb_to_yuv)(na_image *, const na_rgb *);
static int (*na_set_icc)(na_image *, const unsigned char *, size_t);
static int (*na_set_exif)(na_image *, const unsigned char *, size_t);
static int (*na_set_xmp)(na_image *, const unsigned char *, size_t);
static na_encoder *(*na_encoder_create)(void);
static void (*na_encoder_destroy)(na_encoder *);
static int (*na_encoder_write)(na_encoder *, const na_image *, na_rw *);
static void (*na_rw_free)(na_rw *);
static const char *(*na_result)(int);
static char na_msg[320];

static int na_open(void) {
  static int done;
  if (done) return done > 0;
  done = -1;
  na_lib = dlopen("libavif.so.16", RTLD_NOW | RTLD_LOCAL);
  if (!na_lib) na_lib = dlopen("libavif.so", RTLD_NOW | RTLD_LOCAL);
  if (!na_lib) na_lib = dlopen("libavif.16.dylib", RTLD_NOW | RTLD_LOCAL);
  if (!na_lib) return 0;
  /* avifEncoderGetGainMapSizeBytes: only in a libavif built with gain maps (1.2+) */
  if (!dlsym(na_lib, "avifEncoderGetGainMapSizeBytes")) return 0;
#define NA(v, s) if (!(*(void **)&v = dlsym(na_lib, s))) return 0;
  NA(na_image_create, "avifImageCreate") NA(na_image_destroy, "avifImageDestroy")
  NA(na_gain_map_create, "avifGainMapCreate") NA(na_rgb_defaults, "avifRGBImageSetDefaults")
  NA(na_rgb_to_yuv, "avifImageRGBToYUV") NA(na_set_icc, "avifImageSetProfileICC")
  NA(na_set_exif, "avifImageSetMetadataExif") NA(na_set_xmp, "avifImageSetMetadataXMP")
  NA(na_encoder_create, "avifEncoderCreate") NA(na_encoder_destroy, "avifEncoderDestroy")
  NA(na_encoder_write, "avifEncoderWrite") NA(na_rw_free, "avifRWDataFree") NA(na_result, "avifResultToString")
#undef NA
  done = 1;
  return 1;
}

static unsigned na_u32(const unsigned char *p) { return (unsigned)p[0] << 24 | p[1] << 16 | p[2] << 8 | p[3]; }

/* rgba (w x h, SDR, alpha ignored) + gain map rgba (gw x gh) + ISO 21496-1 metadata iso[0, isn) -> name,
   AVIF 8 bits 4:2:0, primaries prim (sRGB transfer). 1 on success; 0 with na_msg, or -1 when libavif
   (with gain maps) is missing, so the caller can fall back to a plain AVIF.
   ponytail: first channel's metadata for the three (as Nova_hdr); 4:0:0 gain map when it is grey. */
static int na_export(const char *name, const unsigned char *rgba, int w, int h, const unsigned char *gm, int gw, int gh,
                     const unsigned char *iso, int isn, int prim, int q,
                     const unsigned char *exif, long en, const unsigned char *icc, long icn, const unsigned char *xmp, long xn) {
  na_image *img = 0;
  na_encoder *enc = 0;
  na_rw out = {0, 0};
  na_rgb rgb;
  struct na_gain_map *g;
  long i, n = (long)gw * gh;
  int r, c, grey = 1, ok = 0;
  FILE *f;
  if (!na_open()) return -1;
  if (isn < 62) { snprintf(na_msg, sizeof na_msg, "gain map metadata too short"); return 0; }
  img = na_image_create(w, h, 8, 3);
  if (!img) goto oom;
  img->prim = prim;
  img->trc = 13;
  img->matrix = 6;
  na_rgb_defaults(&rgb, img);
  rgb.format = 1;
  rgb.ignore_alpha = 1;
  rgb.pixels = (unsigned char *)rgba;
  rgb.row_bytes = w * 4;
  if ((r = na_rgb_to_yuv(img, &rgb))) goto fail;
  for (i = 0; i < n && grey; i++) grey = gm[i * 4] == gm[i * 4 + 1] && gm[i * 4] == gm[i * 4 + 2];
  if (!(g = img->gain_map = na_gain_map_create())) goto oom;
  if (!(g->image = na_image_create(gw, gh, 8, grey ? 4 : 1))) goto oom;
  na_rgb_defaults(&rgb, g->image);
  rgb.format = 1;
  rgb.ignore_alpha = 1;
  rgb.pixels = (unsigned char *)gm;
  rgb.row_bytes = gw * 4;
  if ((r = na_rgb_to_yuv(g->image, &rgb))) goto fail;
  g->base_headroom.n = na_u32(iso + 6);
  g->base_headroom.d = na_u32(iso + 10);
  g->alt_headroom.n = na_u32(iso + 14);
  g->alt_headroom.d = na_u32(iso + 18);
  for (c = 0; c < 3; c++) {
    g->min[c].n = (int)na_u32(iso + 22);
    g->min[c].d = na_u32(iso + 26);
    g->max[c].n = (int)na_u32(iso + 30);
    g->max[c].d = na_u32(iso + 34);
    g->gamma[c].n = na_u32(iso + 38);
    g->gamma[c].d = na_u32(iso + 42);
    g->base_offset[c].n = (int)na_u32(iso + 46);
    g->base_offset[c].d = na_u32(iso + 50);
    g->alt_offset[c].n = (int)na_u32(iso + 54);
    g->alt_offset[c].d = na_u32(iso + 58);
  }
  g->use_base_colour_space = (iso[5] & 0x40) != 0;
  /* A Display P3 profile is said by the CICP above: left out, as libavif (and viewers built on it)
     will not apply a gain map to an image with an ICC profile. */
  if (icn && prim != 12 && (r = na_set_icc(img, icc, icn))) goto fail;
  if (en && (r = na_set_exif(img, exif, en))) goto fail;
  if (xn && (r = na_set_xmp(img, xmp, xn))) goto fail;
  if (!(enc = na_encoder_create())) goto oom;
  enc->quality = q;
  enc->quality_gain_map = q;
  enc->max_threads = (int)sysconf(_SC_NPROCESSORS_ONLN);
  enc->speed = 6;          /* libheif's aom default; libavif's leaves aom at its slowest (30x longer) */
  enc->auto_tiling = 1;    /* tiles: aom's threads work on a 24 Mpx photo */
  if ((r = na_encoder_write(enc, img, &out))) goto fail;
  f = fopen(name, "wb");
  if (!f || fwrite(out.data, 1, out.size, f) != out.size) {
    snprintf(na_msg, sizeof na_msg, "cannot write %s", name);
    if (f) fclose(f);
    goto end;
  }
  ok = fclose(f) == 0;
  if (!ok) snprintf(na_msg, sizeof na_msg, "cannot write %s", name);
  goto end;
oom:
  snprintf(na_msg, sizeof na_msg, "out of memory");
  goto end;
fail:
  snprintf(na_msg, sizeof na_msg, "libavif: %s%s%s", na_result(r), enc && enc->diag[0] ? ": " : "", enc ? enc->diag : "");
end:
  na_rw_free(&out);
  if (enc) na_encoder_destroy(enc);
  if (img) na_image_destroy(img);
  return ok;
}
`;

Public

  - load name:String pixels px:Boolean :Boolean <-
  // Decodes name (px False: metadata only). Then width, height, has_alpha, rgba, meta*, message.
  ( + pe:C_array Char
    + p:Int
    pe := name.to_external
    p := px.to_int
    `nh_load((char *)@pe, @p)`:Int != 0
  )

  - width:Int <- `nh_w`:Int

  - height:Int <- `nh_h`:Int

  - has_alpha:Boolean <- `nh_alpha`:Int != 0

  // RGBA pixels of the last load (owned here: copy them before the next load).
  - rgba:C_array Uint8 <- `nh_px`:C_array Uint8

  // Metadata blocks of the last load: [u32 kind][u32 length][payload], kinds as JPEG segments.
  - meta:C_array Uint8 <- `nh_meta`:C_array Uint8

  - meta_size:Int <- `nh_meta_n`:Int

  // Writes name as AVIF (av1) or HEIC. rgba: 4 bytes per pixel. Metadata: buf[pos, pos + len).
  - export name:String pixels rgba:C_array Uint8 size (w,h:Int) planes np:Int avif av:Boolean lossless ll:Boolean quality q:Int meta (e:C_array Uint8, ep,en:Int, c:C_array Uint8, cn:Int, x:C_array Uint8, xp,xn:Int) :Boolean <-
  ( + pe:C_array Char
    + a,l:Int
    pe := name.to_external
    a := av.to_int
    l := ll.to_int
    `nh_export((char *)@pe, @rgba, @w, @h, @np, @a, @l, @q, @e + @ep, @en, @c, @cn, @x + @xp, @xn, 0, 0)`:Int != 0
  )

  // HDR: pq = 16-bit big-endian RGB coded PQ (Nova_hdr.apply), written 10 bits; prim: cICP primaries.
  - export_hdr name:String pq pq:C_array Uint8 size (w,h:Int) primaries prim:Int avif av:Boolean quality q:Int meta (e:C_array Uint8, ep,en:Int, x:C_array Uint8, xp,xn:Int) :Boolean <-
  ( + pe:C_array Char
    + a:Int
    pe := name.to_external
    a := av.to_int
    `nh_export((char *)@pe, @pq, @w, @h, 3, @a, 0, @q, @e + @ep, @en, 0, 0, @x + @xp, @xn, @pq, @prim)`:Int != 0
  )

  // AVIF with the HDR gain map gm (gw x gh, RGBA) and its ISO 21496-1 metadata iso[ip, ip + n): the
  // SDR image shows everywhere, HDR screens apply the gain map. 1: written, 0: error (message),
  // -1: no libavif with gain maps (write a plain AVIF instead).
  - export_gain_map name:String px rgba:C_array Uint8 size (w,h:Int) gain (gm:C_array Uint8, gw,gh:Int) iso (m:C_array Uint8, mp,mn:Int) prim prim:Int q q:Int meta (e:C_array Uint8, ep,en:Int, c:C_array Uint8, cn:Int, x:C_array Uint8, xp,xn:Int) :Int <-
  ( + pe:C_array Char
    pe := name.to_external
    `na_export((char *)@pe, @rgba, @w, @h, @gm, @gw, @gh, @m + @mp, @mn, @prim, @q, @e + @ep, @en, @c, @cn, @x + @xp, @xn)`:Int
  )

  // The same as a HEIC, through libnova-heif (-1: not installed, write a plain HEIC instead).
  - export_heic_gain_map name:String px rgba:C_array Uint8 size (w,h:Int) gain (gm:C_array Uint8, gw,gh:Int) iso (m:C_array Uint8, mp,mn:Int) prim prim:Int q q:Int meta (e:C_array Uint8, ep,en:Int, c:C_array Uint8, cn:Int, x:C_array Uint8, xp,xn:Int) :Int <-
  ( + pe:C_array Char
    pe := name.to_external
    `ng_export((char *)@pe, @rgba, @w, @h, @gm, @gw, @gh, @m + @mp, @mn, @prim, @q, @e + @ep, @en, @c, @cn, @x + @xp, @xn)`:Int
  )

  // HDR gain map of the last pixel load (gain_width 0: none): RGBA, and its ISO 21496-1 metadata.
  - gain_width:Int <- `nh_gm_w`:Int

  - gain_height:Int <- `nh_gm_h`:Int

  - gain_map:C_array Uint8 <- `nh_gm`:C_array Uint8

  - gain_meta:C_array Uint8 <- `nh_iso`:C_array Uint8

  - gain_meta_size:Int <- `nh_iso_n`:Int

  - message:String <-
  ( + result:String_buffer
    result := String_buffer.create 64
    (`na_msg[0]`:Int != 0).if {
      result.from_external_copy (`na_msg`:C_array Char)
    } else {
      result.from_external_copy (`nh_msg`:C_array Char)
    }
    result.to_string
  )
