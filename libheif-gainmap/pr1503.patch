+size_t heif_image_handle_get_derived_image_raw_color_profile_size(const heif_image_handle* handle)
+{
+  auto profile_icc = handle->image->get_derived_img_color_profile_icc();
+  if (profile_icc) {
+    return profile_icc->get_data().size();
+  }
+  else {
+    return 0;
+  }
